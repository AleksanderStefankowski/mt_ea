//--- Stops EA and further execution when required data/handle is missing (no silent fallbacks).
void FatalError(string msg)
{
   Print("FATAL: ", msg);
   ExpertRemove();
}

//+------------------------------------------------------------------+
void FalgoFatalIfFileOpenFailed(const string path, const int fh)
{
   if(fh == INVALID_HANDLE)
      FatalError("File could not be opened: " + path);
}

//+------------------------------------------------------------------+
bool FalgoFatalIfCapacityFull(const string what, const int count, const int limit, const string raiseDefine = "")
{
   if(count < limit)
      return false;
   string msg = what + " full (" + IntegerToString(limit) + ")";
   if(raiseDefine != "")
      msg += "; raise " + raiseDefine;
   FatalError(msg);
   return true;
}
