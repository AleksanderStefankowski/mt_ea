{
   if(kLast < 0 || kLast >= g_barsInDay) return false;
   const datetime tBar = g_m1Rates[kLast].time;
   if(GetSessionForCandleTime(tBar) != "RTH") return true;
   double ibl;
   if(!GetIBlowAtBar(kLast, ibl)) return false;
   return (levelPx > ibl);
}

