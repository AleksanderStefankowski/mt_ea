      outStats.mfeCandle1Based = g_timeAlgoOpenLifetime[i].mfeCandle1Based;
      outStats.maeCandle1Based = g_timeAlgoOpenLifetime[i].maeCandle1Based;
      outStats.closeDecision = g_timeAlgoOpenLifetime[i].closeDecisionReason;
