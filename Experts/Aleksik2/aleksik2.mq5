//+------------------------------------------------------------------+
void RebuildBreakdownAlgoSlotsRegistry()
{
   g_breakdownAlgoCount = 0;
   for(int a = 0; a < BREAKDOWN_ALGO_REGISTRY_MAX; a++)
      g_breakdownAlgoIdToSlot[a] = -1;
   const int n = ArraySize(g_breakdownRegistryIds);
   for(int i = 0; i < n; i++)
   {
      if(g_breakdownAlgoCount >= BREAKDOWN_ALGO_REGISTRY_MAX)
         FatalError("RebuildBreakdownAlgoSlotsRegistry: BREAKDOWN_ALGO_REGISTRY_MAX exceeded");
      const int algoId = g_breakdownRegistryIds[i];
      g_breakdownAlgos[g_breakdownAlgoCount].algo_id = algoId;
      const int idOff = algoId - MAGIC_BREAKDOWN20000000;
      if(idOff >= 0 && idOff < BREAKDOWN_ALGO_REGISTRY_MAX)
         g_breakdownAlgoIdToSlot[idOff] = g_breakdownAlgoCount;
      g_breakdownAlgoCount++;
   }
   if(BREAKDOWN_ALGO_REGISTRY_MAX > g_breakdownAlgoCount + BREAKDOWN_ALGO_REGISTRY_MAX_HEADROOM)
      FatalError(StringFormat(
         "BREAKDOWN_ALGO_REGISTRY_MAX=%d exceeds wired breakdown algo count %d by more than %d",
         BREAKDOWN_ALGO_REGISTRY_MAX, g_breakdownAlgoCount, BREAKDOWN_ALGO_REGISTRY_MAX_HEADROOM));
}

//+------------------------------------------------------------------+
int BreakdownAlgoSlotIndexByAlgoId(const int algoNumber)
{
   if(!IsBreakdownFamilyAlgoNumber(algoNumber))
      return -1;
   const int idOff = algoNumber - MAGIC_BREAKDOWN20000000;
   if(idOff >= 0 && idOff < BREAKDOWN_ALGO_REGISTRY_MAX)
   {
      const int slot = g_breakdownAlgoIdToSlot[idOff];
      if(slot >= 0 && slot < g_breakdownAlgoCount && g_breakdownAlgos[slot].algo_id == algoNumber)
         return slot;
   }
   for(int i = 0; i < g_breakdownAlgoCount; i++)
   {
      if(g_breakdownAlgos[i].algo_id == algoNumber)
         return i;
   }
   return -1;
}

//+------------------------------------------------------------------+
bool BreakdownAlgoDefForNumber(const int algoNumber, BreakdownAlgoDef &outDef)
{
   const int idx = BreakdownAlgoSlotIndexByAlgoId(algoNumber);
   if(idx < 0)
      return false;
   outDef = g_breakdownAlgos[idx];
   return true;
}

//+------------------------------------------------------------------+
int FalgoAlgoFamilyLeadingDigit(const int algoNumber)
{
   if(algoNumber < MAGIC_ALGO_ID_MIN || algoNumber > MAGIC_ALGO_ID_MAX)
      return -1;
   return algoNumber / FALGO_ALGO_FAMILY_LEADING_DIGIT_SCALE;
}

//+------------------------------------------------------------------+
bool IsTimeFamilyAlgoNumber(const int algoNumber)
{
   return (FalgoAlgoFamilyLeadingDigit(algoNumber) == FALGO_ALGO_FAMILY_TIME_DIGIT);
}

//+------------------------------------------------------------------+
bool IsLevelFamilyAlgoNumber(const int algoNumber)
{
   return (FalgoAlgoFamilyLeadingDigit(algoNumber) == FALGO_ALGO_FAMILY_LEVEL_DIGIT);
}

//+------------------------------------------------------------------+
bool IsBreakdownFamilyAlgoNumber(const int algoNumber)
{
   const int digit = FalgoAlgoFamilyLeadingDigit(algoNumber);
   if(digit == FALGO_ALGO_FAMILY_LEVEL_DIGIT)
      return false;
   return (digit >= FALGO_ALGO_FAMILY_BREAKDOWN_DIGIT_MIN && digit <= FALGO_ALGO_FAMILY_BREAKDOWN_DIGIT_MAX);
}

//+------------------------------------------------------------------+
void FalgoValidateAlgoFamilyDigitConfig()
{
   if(!IsTimeFamilyAlgoNumber(10000001) || IsBreakdownFamilyAlgoNumber(10000001))
      FatalError("FalgoAlgoFamilyDigitConfig: leading digit 1 => time only");
   if(!IsBreakdownFamilyAlgoNumber(20000000) || IsTimeFamilyAlgoNumber(20000000))
      FatalError("FalgoAlgoFamilyDigitConfig: leading digit 2 => breakdown");
   if(!IsLevelFamilyAlgoNumber(30000001) || IsTimeFamilyAlgoNumber(30000001) || IsBreakdownFamilyAlgoNumber(30000001))
      FatalError("FalgoAlgoFamilyDigitConfig: leading digit 3 => level");
   if(!IsBreakdownFamilyAlgoNumber(56789012) || IsTimeFamilyAlgoNumber(56789012))
      FatalError("FalgoAlgoFamilyDigitConfig: leading digit 5 => breakdown");
   if(!IsBreakdownFamilyAlgoNumber(99999999) || IsTimeFamilyAlgoNumber(99999999))
      FatalError("FalgoAlgoFamilyDigitConfig: leading digit 9 => breakdown");
}

//+------------------------------------------------------------------+
bool IsBreakdownFamilyCompositeMagic(const long magic)
{
   return IsBreakdownFamilyAlgoNumber(AlgoFamilyMagicNumber(magic));
}

//+------------------------------------------------------------------+
void RebuildTimeAlgoSlotsRegistry()
{
   g_timeAlgoCount = 0;
   const int n = ArraySize(g_timeAlgoRegistryIds);
   for(int i = 0; i < n; i++)
   {
      if(g_timeAlgoCount >= TIME_ALGO_REGISTRY_MAX)
         FatalError("RebuildTimeAlgoSlotsRegistry: TIME_ALGO_REGISTRY_MAX exceeded");
      g_timeAlgos[g_timeAlgoCount].algo_id = g_timeAlgoRegistryIds[i];
      g_timeAlgoCount++;
   }
   if(TIME_ALGO_REGISTRY_MAX > g_timeAlgoCount + TIME_ALGO_REGISTRY_MAX_HEADROOM)
      FatalError(StringFormat(
         "TIME_ALGO_REGISTRY_MAX=%d exceeds wired time algo count %d by more than %d",
         TIME_ALGO_REGISTRY_MAX, g_timeAlgoCount, TIME_ALGO_REGISTRY_MAX_HEADROOM));
}

//+------------------------------------------------------------------+
int TimeAlgoSlotIndexByAlgoId(const int algoNumber)
{
   for(int i = 0; i < g_timeAlgoCount; i++)
      if(g_timeAlgos[i].algo_id == algoNumber)
         return i;
   return -1;
}

//+------------------------------------------------------------------+
bool TimeAlgoDefForNumber(const int algoNumber, TimeAlgoDef &outDef)
{
   const int idx = TimeAlgoSlotIndexByAlgoId(algoNumber);
   if(idx < 0)
      return false;
   outDef = g_timeAlgos[idx];
   return true;
}

//+------------------------------------------------------------------+
bool IsTimeFamilyCompositeMagic(const long magic)
{
   return IsTimeFamilyAlgoNumber(AlgoFamilyMagicNumber(magic));
}

//+------------------------------------------------------------------+
string BreakdownAlgoCsvFileName(const string dateStr, const int algoNumber, const string suffix)
{
   return dateStr + "_bdalgo" + IntegerToString(algoNumber) + "_" + suffix + ".csv";
}

//+------------------------------------------------------------------+
string BreakdownTradeLifetimeRunLogFileName(const int algoNumber)
{
   return "bdalgo" + IntegerToString(algoNumber) + "_alltrades_log.csv";
}

//+------------------------------------------------------------------+
string BreakdownContinuationModeLogSlug(const ENUM_BREAKDOWN_STREAK_CONTINUATION mode);

string BreakdownBenchmarkAllAlgosFileName()
{
   return "benchmark_all_algos_breakdown.csv";
}

//+------------------------------------------------------------------+
void BreakdownBenchmarkAllAlgosReset()
{
   for(int i = 0; i < BREAKDOWN_ALGO_REGISTRY_MAX; i++)
   {
      g_breakdownAlgoBenchmarkAcc[i].tradesClosed = 0;
      g_breakdownAlgoBenchmarkAcc[i].winsWithRoll = 0;
      g_breakdownAlgoBenchmarkAcc[i].lossesWithRoll = 0;
      g_breakdownAlgoBenchmarkAcc[i].sumPriceDiff = 0.0;
      g_breakdownAlgoBenchmarkAcc[i].sumPriceDiffWithRoll = 0.0;
      g_breakdownAlgoBenchmarkAcc[i].sumMfePts = 0.0;
      g_breakdownAlgoBenchmarkAcc[i].sumMaePts = 0.0;
      g_breakdownAlgoBenchmarkAcc[i].sumMfePtsWithRoll = 0.0;
      g_breakdownAlgoBenchmarkAcc[i].sumMaePtsWithRoll = 0.0;
      g_breakdownAlgoBenchmarkAcc[i].telCount = 0;
      g_breakdownAlgoBenchmarkAcc[i].sumLifetimeHours = 0.0;
   }
}

//+------------------------------------------------------------------+
void BreakdownBenchmarkAllAlgosWrite()
{
   if(!bigflipper_log_breakdown_trade_lifetime)
      return;

   const bool profOn = BacktestProfileEnabled();
   ulong profT0 = 0;
   if(profOn)
      profT0 = GetMicrosecondCount();

   int fh = FileOpen(BreakdownBenchmarkAllAlgosFileName(), FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ | FILE_SHARE_WRITE);
   FalgoFatalIfFileOpenFailed(BreakdownBenchmarkAllAlgosFileName(), fh);

   FileWrite(fh, "algo_id", "continuation_type", "trades_closed",
      "wins_with_roll", "losses_with_roll", "win_rate_pct_with_roll",
      "sum_priceDiff", "avg_priceDiff",
      "sum_priceDiff_with_roll", "avg_priceDiff_with_roll",
      "avg_mfe_pts", "avg_mae_pts", "avg_mfe_pts_with_roll", "avg_mae_pts_with_roll",
      "avg_lifetime_hours", "sum_lifetime_minutes", "sum_lifetime_hours", "sum_lifetime_days",
      "pricediff_vs_hours_ratio", "pricediff_vs_hours_ratio_with_roll");

   for(int i = 0; i < g_breakdownAlgoCount; i++)
   {
      const int algoNumber = g_breakdownAlgos[i].algo_id;
      const int slotIdx = BreakdownAlgoSlotIndexByAlgoId(algoNumber);
      if(slotIdx < 0)
         continue;
      const BreakdownAlgoBenchmarkAcc acc = g_breakdownAlgoBenchmarkAcc[slotIdx];
      const int n = acc.tradesClosed;
      const double avgPriceDiff = (n > 0) ? acc.sumPriceDiff / (double)n : 0.0;
      const double avgPriceDiffWithRoll = (n > 0) ? acc.sumPriceDiffWithRoll / (double)n : 0.0;
      const double winRateWithRoll = (n > 0) ? (100.0 * (double)acc.winsWithRoll / (double)n) : 0.0;
      const double avgMfe = (acc.telCount > 0) ? acc.sumMfePts / (double)acc.telCount : 0.0;
      const double avgMae = (acc.telCount > 0) ? acc.sumMaePts / (double)acc.telCount : 0.0;
      const double avgMfeWithRoll = (acc.telCount > 0) ? acc.sumMfePtsWithRoll / (double)acc.telCount : 0.0;
      const double avgMaeWithRoll = (acc.telCount > 0) ? acc.sumMaePtsWithRoll / (double)acc.telCount : 0.0;
      const double avgLifetime = (n > 0) ? acc.sumLifetimeHours / (double)n : 0.0;
      const double sumLifetimeMinutes = acc.sumLifetimeHours * 60.0;
      const double sumLifetimeDays = acc.sumLifetimeHours / 24.0;
      const string pricediffVsHoursRatio = (acc.sumLifetimeHours > 0.0)
         ? DoubleToString(acc.sumPriceDiff / acc.sumLifetimeHours, 4) : "";
      const string pricediffVsHoursRatioWithRoll = (acc.sumLifetimeHours > 0.0)
         ? DoubleToString(acc.sumPriceDiffWithRoll / acc.sumLifetimeHours, 4) : "";
      const ENUM_BREAKDOWN_STREAK_CONTINUATION mode = g_breakdownAlgos[slotIdx].breakdown_streak_continuation_mode;

      FileWrite(fh,
         IntegerToString(algoNumber),
         BreakdownContinuationModeLogSlug(mode),
         IntegerToString(n),
         IntegerToString(acc.winsWithRoll),
         IntegerToString(acc.lossesWithRoll),
         DoubleToString(winRateWithRoll, 2),
         DoubleToString(acc.sumPriceDiff, _Digits),
         DoubleToString(avgPriceDiff, _Digits),
         DoubleToString(acc.sumPriceDiffWithRoll, _Digits),
         DoubleToString(avgPriceDiffWithRoll, _Digits),
         (acc.telCount > 0 ? DoubleToString(avgMfe, 1) : ""),
         (acc.telCount > 0 ? DoubleToString(avgMae, 1) : ""),
         (acc.telCount > 0 ? DoubleToString(avgMfeWithRoll, 1) : ""),
         (acc.telCount > 0 ? DoubleToString(avgMaeWithRoll, 1) : ""),
         (n > 0 ? DoubleToString(avgLifetime, 1) : ""),
         (n > 0 ? DoubleToString(sumLifetimeMinutes, 1) : ""),
         (n > 0 ? DoubleToString(acc.sumLifetimeHours, 1) : ""),
         (n > 0 ? DoubleToString(sumLifetimeDays, 1) : ""),
         pricediffVsHoursRatio,
         pricediffVsHoursRatioWithRoll);
   }
   FileClose(fh);
   if(profOn)
      BacktestProfAccumulate(BACKTEST_PROF_BREAKDOWN_BENCHMARK_ALGOS, profT0);
}

//+------------------------------------------------------------------+
void BreakdownBenchmarkAllAlgosAccumulateClose(const int algoNumber, const double startPrice, const double endPrice,
   const double lifetimeHours, const double mfePts, const double maePts, const bool hasTel,
   const double rolloverPricediff = 0.0)
{
   if(!bigflipper_log_breakdown_trade_lifetime || startPrice <= 0.0 || endPrice <= 0.0)
      return;
   const int slotIdx = BreakdownAlgoSlotIndexByAlgoId(algoNumber);
   if(slotIdx < 0)
      return;

   BreakdownAlgoBenchmarkAcc acc = g_breakdownAlgoBenchmarkAcc[slotIdx];
   const double rollCost = MathMax(0.0, rolloverPricediff);
   const double priceDiff = endPrice - startPrice;
   const double priceDiffWithRoll = priceDiff - rollCost;
   acc.tradesClosed++;
   acc.sumPriceDiff += priceDiff;
   acc.sumPriceDiffWithRoll += priceDiffWithRoll;
   acc.sumLifetimeHours += lifetimeHours;
   if(priceDiffWithRoll > 0.0)
      acc.winsWithRoll++;
   else if(priceDiffWithRoll < 0.0)
      acc.lossesWithRoll++;
   if(hasTel)
   {
      acc.sumMfePts += mfePts;
      acc.sumMaePts += maePts;
      acc.sumMfePtsWithRoll += mfePts - rollCost;
      acc.sumMaePtsWithRoll += maePts - rollCost;
      acc.telCount++;
   }
   g_breakdownAlgoBenchmarkAcc[slotIdx] = acc;
   BreakdownBenchmarkAllAlgosWrite();
}

void BreakdownWriteTradeLifetimeRunLogHeader(const int fh)
{
   FileWrite(fh, "eventTime", "startTime", "eventType", "close_reason",
      "plannedPrice", "startPrice", "realSLprice", "realTPprice", "endPrice", "priceDiff", "lifetimeHours",
      "trade_customID", "trades_today", "currently_concurrent_trades", "trades_all", "with_rollover_fee", "rollover_pricediff",
      "priceEnd_with_roll", "priceDiff_with_roll", "mfe_with_roll", "mae_with_roll");
}

void BreakdownResetTradeLifetimeRunLogsOnInit()
{
   BreakdownBenchmarkAllAlgosReset();
   for(int i = 0; i < BREAKDOWN_ALGO_REGISTRY_MAX; i++)
      g_breakdownAlgoNextTradeCustomId[i] = 0;
   if(!bigflipper_log_breakdown_trade_lifetime)
      return;
   for(int i = 0; i < g_breakdownAlgoCount; i++)
   {
      const int algoNumber = g_breakdownAlgos[i].algo_id;
      if(!IsBreakdownFamilyAlgoNumber(algoNumber))
         continue;
      const string fname = BreakdownTradeLifetimeRunLogFileName(algoNumber);
      int fh = FileOpen(fname, FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ | FILE_SHARE_WRITE);
      FalgoFatalIfFileOpenFailed(fname, fh);
      BreakdownWriteTradeLifetimeRunLogHeader(fh);
      FileClose(fh);
   }
   BreakdownBenchmarkAllAlgosWrite();
}

//+------------------------------------------------------------------+
void BreakdownRememberPendingPlannedPrice(const long magic, const double plannedPrice, const datetime sentTime)
{
   if(magic <= 0 || plannedPrice <= 0.0)
      return;
   if(!IsBreakdownFamilyCompositeMagic(magic))
      return;
   const int slotIdx = BreakdownAlgoSlotIndexByAlgoId(AlgoFamilyMagicNumber(magic));
   if(slotIdx < 0)
      return;
   g_breakdownPendingPlannedBySlot[slotIdx].plannedPrice = plannedPrice;
   g_breakdownPendingPlannedBySlot[slotIdx].sentTime = sentTime;
   g_breakdownPendingPlannedBySlot[slotIdx].active = true;
}

//+------------------------------------------------------------------+
bool BreakdownTakePendingOrderContext(const long magic, double &outPlannedPrice, datetime &outSentTime)
{
   outPlannedPrice = 0.0;
   outSentTime = 0;
   if(!IsBreakdownFamilyCompositeMagic(magic))
      return false;
   const int slotIdx = BreakdownAlgoSlotIndexByAlgoId(AlgoFamilyMagicNumber(magic));
   if(slotIdx < 0 || !g_breakdownPendingPlannedBySlot[slotIdx].active)
      return false;
   outPlannedPrice = g_breakdownPendingPlannedBySlot[slotIdx].plannedPrice;
   outSentTime = g_breakdownPendingPlannedBySlot[slotIdx].sentTime;
   g_breakdownPendingPlannedBySlot[slotIdx].active = false;
   return true;
}

//+------------------------------------------------------------------+
double BreakdownTakePendingPlannedPrice(const long magic)
{
   double plannedPrice = 0.0;
   datetime sentTime = 0;
   if(BreakdownTakePendingOrderContext(magic, plannedPrice, sentTime))
      return plannedPrice;
   return 0.0;
}

//+------------------------------------------------------------------+
//| Planned limit price from the position's opening order only (no fallbacks). |
//+------------------------------------------------------------------+
double BreakdownPlannedPriceFromOpeningOrder(const ulong positionId)
{
   if(positionId == 0 || !HistorySelectByPosition(positionId))
      return 0.0;
   for(int di = 0; di < HistoryDealsTotal(); di++)
   {
      const ulong dealTicket = HistoryDealGetTicket(di);
      if(dealTicket == 0)
         continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY) != DEAL_ENTRY_IN)
         continue;
      const ulong orderTicket = HistoryDealGetInteger(dealTicket, DEAL_ORDER);
      if(orderTicket == 0 || !HistoryOrderSelect(orderTicket))
         return 0.0;
      const double planned = HistoryOrderGetDouble(orderTicket, ORDER_PRICE_OPEN);
      return (planned > 0.0 ? planned : 0.0);
   }
   return 0.0;
}

//+------------------------------------------------------------------+
int BreakdownRegisterOpenTradeLifetime(const ulong positionId, const int algoNumber,
   const datetime sentTime, const datetime startTime, const datetime breakdownSequenceEndTime, const double plannedPrice,
   const double startPrice, const double realSLprice, const double realTPprice)
{
   if(positionId == 0 || algoNumber <= 0 || startTime <= 0)
   {
      FatalError(StringFormat("BreakdownRegisterOpenTradeLifetime: invalid args positionId=%I64u algo=%d startTime=%s",
         positionId, algoNumber, TimeToString(startTime, TIME_DATE | TIME_SECONDS)));
      return -1;
   }
   const datetime sentResolved = FalgoResolveTradeSentTime(sentTime, 0, startTime);
   for(int i = 0; i < BREAKDOWN_OPEN_LIFETIME_MAX; i++)
   {
      if(g_breakdownOpenLifetime[i].active && g_breakdownOpenLifetime[i].positionId == positionId)
      {
         g_breakdownOpenLifetime[i].algoNumber = algoNumber;
         g_breakdownOpenLifetime[i].sentTime = sentResolved;
         g_breakdownOpenLifetime[i].startTime = startTime;
         g_breakdownOpenLifetime[i].breakdownSequenceEndTime = breakdownSequenceEndTime;
         g_breakdownOpenLifetime[i].plannedPrice = plannedPrice;
         g_breakdownOpenLifetime[i].startPrice = startPrice;
         g_breakdownOpenLifetime[i].realSLprice = realSLprice;
         g_breakdownOpenLifetime[i].realTPprice = realTPprice;
         FalgoLifetimeEnsureRolloverState(startTime, g_breakdownOpenLifetime[i].rolloverWedDayStart,
            g_breakdownOpenLifetime[i].withRolloverFee, g_breakdownOpenLifetime[i].rolloverPricediff);
         return g_breakdownOpenLifetime[i].tradeCustomId;
      }
   }
   int tradeCustomId = 0;
   const int algoIdx = BreakdownAlgoSlotIndexByAlgoId(algoNumber);
   if(algoIdx >= 0)
   {
      g_breakdownAlgoNextTradeCustomId[algoIdx]++;
      tradeCustomId = g_breakdownAlgoNextTradeCustomId[algoIdx];
   }
   for(int i = 0; i < BREAKDOWN_OPEN_LIFETIME_MAX; i++)
   {
      if(!g_breakdownOpenLifetime[i].active)
      {
         ZeroMemory(g_breakdownOpenLifetime[i]);
         g_breakdownOpenLifetime[i].positionId = positionId;
         g_breakdownOpenLifetime[i].algoNumber = algoNumber;
         g_breakdownOpenLifetime[i].tradeCustomId = tradeCustomId;
         g_breakdownOpenLifetime[i].sentTime = sentResolved;
         g_breakdownOpenLifetime[i].startTime = startTime;
         g_breakdownOpenLifetime[i].breakdownSequenceEndTime = breakdownSequenceEndTime;
         g_breakdownOpenLifetime[i].plannedPrice = plannedPrice;
         g_breakdownOpenLifetime[i].startPrice = startPrice;
         g_breakdownOpenLifetime[i].realSLprice = realSLprice;
         g_breakdownOpenLifetime[i].realTPprice = realTPprice;
         g_breakdownOpenLifetime[i].active = true;
         FalgoLifetimePosMapInsert(positionId, i, g_breakdownLifetimePosMapKey, g_breakdownLifetimePosMapSlot,
            FALGO_LIFETIME_POS_MAP_BUCKETS);
         FalgoLifetimeEnsureRolloverState(startTime, g_breakdownOpenLifetime[i].rolloverWedDayStart,
            g_breakdownOpenLifetime[i].withRolloverFee, g_breakdownOpenLifetime[i].rolloverPricediff);
         return tradeCustomId;
      }
   }
   FatalError(StringFormat("BreakdownRegisterOpenTradeLifetime: full (%d); raise BREAKDOWN_OPEN_LIFETIME_MAX",
      BREAKDOWN_OPEN_LIFETIME_MAX));
   return -1;
}

//+------------------------------------------------------------------+
void FalgoLifetimePosMapClear(int &slots[], const int bucketCount)
{
   for(int bi = 0; bi < bucketCount; bi++)
      slots[bi] = -1;
}

//+------------------------------------------------------------------+
int FalgoLifetimePosMapFind(const ulong positionId, const ulong &keys[], const int &slots[], const int bucketCount)
{
   if(positionId == 0 || bucketCount <= 0)
      return -1;
   int idx = (int)(positionId % (ulong)bucketCount);
   for(int probe = 0; probe < bucketCount; probe++)
   {
      const int mappedSlot = slots[idx];
      if(mappedSlot < 0)
         return -1;
      if(keys[idx] == positionId)
         return mappedSlot;
      idx++;
      if(idx >= bucketCount)
         idx = 0;
   }
   return -1;
}

//+------------------------------------------------------------------+
bool FalgoLifetimePosMapInsert(const ulong positionId, const int lifetimeSlot, ulong &keys[], int &slots[],
   const int bucketCount)
{
   if(positionId == 0 || lifetimeSlot < 0 || bucketCount <= 0)
      return false;
   const int existing = FalgoLifetimePosMapFind(positionId, keys, slots, bucketCount);
   if(existing >= 0)
      return (existing == lifetimeSlot);
   int idx = (int)(positionId % (ulong)bucketCount);
   for(int probe = 0; probe < bucketCount; probe++)
   {
      if(slots[idx] < 0)
      {
         keys[idx] = positionId;
         slots[idx] = lifetimeSlot;
         return true;
      }
      idx++;
      if(idx >= bucketCount)
         idx = 0;
   }
   return false;
}

//+------------------------------------------------------------------+
void BreakdownOpenLifetimePosMapRebuild()
{
   FalgoLifetimePosMapClear(g_breakdownLifetimePosMapSlot, FALGO_LIFETIME_POS_MAP_BUCKETS);
   for(int si = 0; si < BREAKDOWN_OPEN_LIFETIME_MAX; si++)
   {
      if(!g_breakdownOpenLifetime[si].active)
         continue;
      const ulong positionId = g_breakdownOpenLifetime[si].positionId;
      if(positionId == 0)
         continue;
      FalgoLifetimePosMapInsert(positionId, si, g_breakdownLifetimePosMapKey, g_breakdownLifetimePosMapSlot,
         FALGO_LIFETIME_POS_MAP_BUCKETS);
   }
}

//+------------------------------------------------------------------+
void TimeAlgoOpenLifetimePosMapRebuild()
{
   FalgoLifetimePosMapClear(g_timeAlgoLifetimePosMapSlot, FALGO_LIFETIME_POS_MAP_BUCKETS);
   for(int si = 0; si < TIME_ALGO_OPEN_LIFETIME_MAX; si++)
   {
      if(!g_timeAlgoOpenLifetime[si].active)
         continue;
      const ulong positionId = g_timeAlgoOpenLifetime[si].positionId;
      if(positionId == 0)
         continue;
      FalgoLifetimePosMapInsert(positionId, si, g_timeAlgoLifetimePosMapKey, g_timeAlgoLifetimePosMapSlot,
         FALGO_LIFETIME_POS_MAP_BUCKETS);
   }
}

//+------------------------------------------------------------------+
void FalgoRebuildOpenLifetimePosMapsOnInit()
{
   BreakdownOpenLifetimePosMapRebuild();
   TimeAlgoOpenLifetimePosMapRebuild();
   LevelAlgoOpenLifetimePosMapRebuild();
}

//+------------------------------------------------------------------+
int BreakdownOpenLifetimeSlotByPositionId(const ulong positionId)
{
   if(positionId == 0)
      return -1;
   const int mapped = FalgoLifetimePosMapFind(positionId, g_breakdownLifetimePosMapKey, g_breakdownLifetimePosMapSlot,
      FALGO_LIFETIME_POS_MAP_BUCKETS);
   if(mapped >= 0 && mapped < BREAKDOWN_OPEN_LIFETIME_MAX
      && g_breakdownOpenLifetime[mapped].active
      && g_breakdownOpenLifetime[mapped].positionId == positionId)
      return mapped;
   for(int i = 0; i < BREAKDOWN_OPEN_LIFETIME_MAX; i++)
   {
      if(g_breakdownOpenLifetime[i].active && g_breakdownOpenLifetime[i].positionId == positionId)
      {
         FalgoLifetimePosMapInsert(positionId, i, g_breakdownLifetimePosMapKey, g_breakdownLifetimePosMapSlot,
            FALGO_LIFETIME_POS_MAP_BUCKETS);
         return i;
      }
   }
   return -1;
}

//+------------------------------------------------------------------+
int TimeAlgoOpenLifetimeSlotByPositionId(const ulong positionId)
{
   if(positionId == 0)
      return -1;
   const int mapped = FalgoLifetimePosMapFind(positionId, g_timeAlgoLifetimePosMapKey, g_timeAlgoLifetimePosMapSlot,
      FALGO_LIFETIME_POS_MAP_BUCKETS);
   if(mapped >= 0 && mapped < TIME_ALGO_OPEN_LIFETIME_MAX
      && g_timeAlgoOpenLifetime[mapped].active
      && g_timeAlgoOpenLifetime[mapped].positionId == positionId)
      return mapped;
   for(int i = 0; i < TIME_ALGO_OPEN_LIFETIME_MAX; i++)
   {
      if(g_timeAlgoOpenLifetime[i].active && g_timeAlgoOpenLifetime[i].positionId == positionId)
      {
         FalgoLifetimePosMapInsert(positionId, i, g_timeAlgoLifetimePosMapKey, g_timeAlgoLifetimePosMapSlot,
            FALGO_LIFETIME_POS_MAP_BUCKETS);
         return i;
      }
   }
   return -1;
}

//+------------------------------------------------------------------+
bool BreakdownOpenLifetimeBreakdownEnd(const ulong positionId, datetime &outBreakdownEnd)
{
   outBreakdownEnd = 0;
   const int slot = BreakdownOpenLifetimeSlotByPositionId(positionId);
   if(slot < 0)
      return false;
   outBreakdownEnd = g_breakdownOpenLifetime[slot].breakdownSequenceEndTime;
   return (outBreakdownEnd > 0);
}

//+------------------------------------------------------------------+
bool BreakdownTakeOpenTradeLifetime(const ulong positionId, BreakdownOpenTradeLifetimeRec &outRec)
{
   ZeroMemory(outRec);
   for(int i = 0; i < BREAKDOWN_OPEN_LIFETIME_MAX; i++)
   {
      if(g_breakdownOpenLifetime[i].active && g_breakdownOpenLifetime[i].positionId == positionId)
      {
         outRec = g_breakdownOpenLifetime[i];
         g_breakdownOpenLifetime[i].active = false;
         BreakdownOpenLifetimePosMapRebuild();
         return true;
      }
   }
   return false;
}

//+------------------------------------------------------------------+
void BreakdownRememberPendingCloseReason(const ulong positionId, const string reason)
{
   if(positionId == 0 || reason == "")
      return;
   for(int i = 0; i < BREAKDOWN_OPEN_LIFETIME_MAX; i++)
   {
      if(g_breakdownOpenLifetime[i].active && g_breakdownOpenLifetime[i].positionId == positionId)
         g_breakdownOpenLifetime[i].pendingCloseReason = reason;
   }
}

//+------------------------------------------------------------------+
void BreakdownRememberCloseDecision(const ulong positionId, const string decision, const string detail)
{
   if(positionId == 0)
      return;
   for(int i = 0; i < BREAKDOWN_OPEN_LIFETIME_MAX; i++)
   {
      if(g_breakdownOpenLifetime[i].active && g_breakdownOpenLifetime[i].positionId == positionId)
      {
         if(decision != "")
            g_breakdownOpenLifetime[i].closeDecisionReason = decision;
         if(detail != "")
            g_breakdownOpenLifetime[i].closeDecisionDetail = detail;
      }
   }
}

string BreakdownTradeLifetimeCloseReasonFromExit(const ENUM_DEAL_REASON dealReason,
   const ulong positionId, const long entryMagic, const datetime startTime);

string BreakdownLifetimeLogPriceCol(const double price)
{
   return (price > 0.0 ? DoubleToString(price, _Digits) : "");
}

void BreakdownResolveBrokerTpSlForLifetimeLog(const int algoNumber, const datetime atTime, const double plannedPrice,
   double &outRealSLprice, double &outRealTPprice)
{
   const int algoSlot = BreakdownAlgoSlotIndexByAlgoId(algoNumber);
   if(algoSlot < 0)
      return;
   const BreakdownAlgoDef bd = g_breakdownAlgos[algoSlot];
   const Breakdown15mState bdSnap = Breakdown15mSnapForAlgo(algoNumber, atTime);
   if(outRealTPprice <= 0.0 && bd.tp_enabled)
   {
      if(bigflipper_plus_200p_realTP_override && plannedPrice > 0.0)
      {
         FalgoMagicKey planKey;
         if(FalgoBuildMagicKeyForBreakdownPlacement(algoNumber, FALGO_DIRECTION_LONG_LIMIT, plannedPrice, bdSnap, planKey))
            outRealTPprice = FalgoBrokerTpPriceFromMagicTargetPlusOverride(plannedPrice, planKey);
      }
      if(outRealTPprice <= 0.0 && !bigflipper_plus_200p_realTP_override)
      {
         outRealTPprice = FalgoBreakdownPriceAtRangePercent(bdSnap.breakdownLow, bdSnap.startHigh,
            bd.tp_notsecret_range_percent);
      }
   }
   if(outRealSLprice <= 0.0 && bd.sl_enabled && plannedPrice > 0.0 && bd.sl_points > 0.0)
      outRealSLprice = NormalizeDouble(plannedPrice - PointSized(bd.sl_points), _Digits);
}

//+------------------------------------------------------------------+
string BreakdownLifetimeLogTelemetryPtsCol(const double pts, const bool fill)
{
   if(!fill)
      return "";
   return DoubleToString(pts, 1);
}

//+------------------------------------------------------------------+
void BreakdownStashGatesCloseTelemetry(const int algoNumber, const datetime closeTime,
   const long entryMagic, const datetime startTime)
{
   const int slotIdx = BreakdownAlgoSlotIndexByAlgoId(algoNumber);
   if(slotIdx < 0 || closeTime <= 0 || startTime <= 0)
      return;
   FalgoBtClosedTradeStats stats;
   if(!FalgoGetBreakdownTimeTradeStats(entryMagic, startTime, stats))
      return;
   g_breakdownGatesCloseTelBarTime[slotIdx] = closeTime - (closeTime % 60);
   g_breakdownGatesCloseTelMfePts[slotIdx] = stats.mfePts;
   g_breakdownGatesCloseTelMaePts[slotIdx] = stats.maePts;
   g_breakdownGatesCloseTelValid[slotIdx] = true;
}

//+------------------------------------------------------------------+
void BreakdownTakeGatesCloseTelemetryForBar(const int slotIdx, const datetime barOpenTime,
   double &outMfePts, double &outMaePts, bool &outFilled)
{
   outMfePts = 0.0;
   outMaePts = 0.0;
   outFilled = false;
   if(slotIdx < 0 || !g_breakdownGatesCloseTelValid[slotIdx])
      return;
   if(g_breakdownGatesCloseTelBarTime[slotIdx] != barOpenTime)
      return;
   outMfePts = g_breakdownGatesCloseTelMfePts[slotIdx];
   outMaePts = g_breakdownGatesCloseTelMaePts[slotIdx];
   outFilled = true;
   g_breakdownGatesCloseTelValid[slotIdx] = false;
}

//+------------------------------------------------------------------+
int BreakdownAlgoTradesTodayForLog(const int algoNumber)
{
   return BreakdownPlanTradeNumToday(algoNumber);
}

//+------------------------------------------------------------------+
int BreakdownAlgoTradesAllForLog(const int algoNumber)
{
   const int idx = BreakdownAlgoSlotIndexByAlgoId(algoNumber);
   if(idx < 0)
      return 0;
   return g_breakdownAlgoTradesAll[idx];
}

//+------------------------------------------------------------------+
int BreakdownAlgoConcurrentOpenTradesForLog(const int algoNumber)
{
   int n = 0;
   for(int i = 0; i < BREAKDOWN_OPEN_LIFETIME_MAX; i++)
   {
      if(g_breakdownOpenLifetime[i].active && g_breakdownOpenLifetime[i].algoNumber == algoNumber)
         n++;
   }
   return n;
}

//+------------------------------------------------------------------+
int TimeAlgoConcurrentOpenTradesForLog(const int algoNumber)
{
   int n = 0;
   for(int i = 0; i < TIME_ALGO_OPEN_LIFETIME_MAX; i++)
   {
      if(g_timeAlgoOpenLifetime[i].active && g_timeAlgoOpenLifetime[i].algoNumber == algoNumber)
         n++;
   }
   return n;
}

//+------------------------------------------------------------------+
void BreakdownAppendTradeLifetimeLogRow(const int algoNumber, const datetime eventTime, const datetime startTime,
   const string eventType, const string closeReason, const double plannedPrice, const double startPrice,
   const double realSLprice, const double realTPprice, const double endPrice, const double lifetimeHours,
   const double mfePts = 0.0, const double maePts = 0.0, const bool fillMaeMfe = false,
   const bool withRolloverFee = false, const double rolloverPricediff = 0.0, const int tradeCustomId = 0)
{
   if(!IsBreakdownFamilyAlgoNumber(algoNumber))
      return;

   const int tradesToday = BreakdownAlgoTradesTodayForLog(algoNumber);
   const int concurrentOpen = BreakdownAlgoConcurrentOpenTradesForLog(algoNumber);
   const int tradesAll = BreakdownAlgoTradesAllForLog(algoNumber);

   if(bigflipper_log_breakdown_trade_lifetime)
      FalgoAppendAllTradesLifetimeLogRowToFile(BreakdownTradeLifetimeRunLogFileName(algoNumber),
         eventTime, startTime, eventType, closeReason, plannedPrice, startPrice, realSLprice, realTPprice, endPrice,
         lifetimeHours, tradeCustomId, tradesToday, concurrentOpen, tradesAll, mfePts, maePts, fillMaeMfe,
         withRolloverFee, rolloverPricediff);
}

//+------------------------------------------------------------------+
void BreakdownLogTradeOpenedLifetime(const ulong positionId, const long magic, const datetime fillTime,
   const double fillPrice, const ulong orderTicket)
{
   if(!IsBreakdownFamilyCompositeMagic(magic))
      return;
   const int algoNumber = AlgoFamilyMagicNumber(magic);
   if(!IsBreakdownFamilyAlgoNumber(algoNumber))
      return;

   double plannedPrice = 0.0;
   datetime sentTime = 0;
   BreakdownTakePendingOrderContext(magic, plannedPrice, sentTime);
   if(plannedPrice <= 0.0 && orderTicket > 0 && HistoryOrderSelect(orderTicket))
      plannedPrice = HistoryOrderGetDouble(orderTicket, ORDER_PRICE_OPEN);
   if(plannedPrice <= 0.0)
      plannedPrice = fillPrice;

   const double startPrice = (fillPrice > 0.0 ? fillPrice : plannedPrice);
   const datetime startTime = (fillTime > 0 ? fillTime : g_lastTimer1Time);
   const bool isNewOpen = (BreakdownOpenLifetimeSlotByPositionId(positionId) < 0);
   if(sentTime <= 0)
      sentTime = FalgoPendingOrderSentTimeFromTicket(orderTicket, startTime);
   sentTime = FalgoResolveTradeSentTime(sentTime, 0, startTime);
   double realSLprice = 0.0;
   double realTPprice = 0.0;
   if(orderTicket > 0 && HistoryOrderSelect(orderTicket))
   {
      realTPprice = HistoryOrderGetDouble(orderTicket, ORDER_TP);
      realSLprice = HistoryOrderGetDouble(orderTicket, ORDER_SL);
   }
   BreakdownResolveBrokerTpSlForLifetimeLog(algoNumber, startTime, plannedPrice, realSLprice, realTPprice);
   RefreshGlobalBreakdown15mSnap(startTime);
   const Breakdown15mState bdSnap = Breakdown15mSnapForAlgo(algoNumber, startTime);
   const datetime breakdownEnd = bdSnap.endTime;
   const int tradeCustomId = BreakdownRegisterOpenTradeLifetime(positionId, algoNumber, sentTime, startTime, breakdownEnd,
      plannedPrice, startPrice, realSLprice, realTPprice);
   const int lifeIdx = BreakdownOpenLifetimeSlotByPositionId(positionId);
   if(lifeIdx >= 0)
      BreakdownHydrateLifetimeSecretTpFromMagic(lifeIdx, positionId, magic);
   const int algoIdx = BreakdownAlgoSlotIndexByAlgoId(algoNumber);
   if(algoIdx >= 0)
      g_breakdownAlgoTradesAll[algoIdx]++;
   if(isNewOpen && algoIdx >= 0)
   {
      BreakdownDayTradeCountsResetIfNewDay();
      const datetime dayStart = FalgoCalendarDayStart();
      if(dayStart != 0 && startTime >= dayStart && startTime < dayStart + 86400)
         g_breakdownAlgoDayTradesToday[algoIdx]++;
   }
   if(bigflipper_log_breakdown_trade_lifetime)
      BreakdownAppendTradeLifetimeLogRow(algoNumber, startTime, startTime, "trade opened", "",
         plannedPrice, startPrice, realSLprice, realTPprice, 0.0, 0.0, 0.0, 0.0, false, false, 0.0, tradeCustomId);
}

//+------------------------------------------------------------------+
void BreakdownLogTradeClosedLifetime(const ulong positionId, const long entryMagic, const datetime closeTime,
   const double closePriceIn, const ENUM_DEAL_REASON dealReason, const double closeProfitIn)
{
   if(!IsBreakdownFamilyCompositeMagic(entryMagic))
      return;

   BreakdownOpenTradeLifetimeRec openRec;
   datetime sentTime = 0;
   datetime startTime = 0;
   double plannedPrice = 0.0;
   double startPrice = 0.0;
   double realSLprice = 0.0;
   double realTPprice = 0.0;
   string pendingCloseReason = "";
   bool withRolloverFee = false;
   double rolloverPricediff = 0.0;
   int tradeCustomId = 0;
   int algoNumber = AlgoFamilyMagicNumber(entryMagic);
   ulong entryOrderTicket = 0;
   const bool gotOpenRec = BreakdownTakeOpenTradeLifetime(positionId, openRec);
   if(gotOpenRec)
   {
      algoNumber = openRec.algoNumber;
      tradeCustomId = openRec.tradeCustomId;
      sentTime = openRec.sentTime;
      startTime = openRec.startTime;
      plannedPrice = openRec.plannedPrice;
      startPrice = openRec.startPrice;
      realSLprice = openRec.realSLprice;
      realTPprice = openRec.realTPprice;
      pendingCloseReason = openRec.pendingCloseReason;
      withRolloverFee = openRec.withRolloverFee;
      rolloverPricediff = openRec.rolloverPricediff;
   }
   else if(HistorySelectByPosition((long)positionId))
   {
      for(int j = 0; j < HistoryDealsTotal(); j++)
      {
         const ulong dealTicket = HistoryDealGetTicket(j);
         if(dealTicket == 0)
            continue;
         if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY) != DEAL_ENTRY_IN)
            continue;
         startTime = (datetime)HistoryDealGetInteger(dealTicket, DEAL_TIME);
         startPrice = HistoryDealGetDouble(dealTicket, DEAL_PRICE);
         plannedPrice = startPrice;
         entryOrderTicket = HistoryDealGetInteger(dealTicket, DEAL_ORDER);
         sentTime = FalgoPendingOrderSentTimeFromTicket(entryOrderTicket, startTime);
         if(!IsBreakdownFamilyAlgoNumber(algoNumber))
            algoNumber = AlgoFamilyMagicNumber(HistoryDealGetInteger(dealTicket, DEAL_MAGIC));
         break;
      }
   }
   if(entryOrderTicket > 0 && HistoryOrderSelect(entryOrderTicket))
   {
      realTPprice = HistoryOrderGetDouble(entryOrderTicket, ORDER_TP);
      realSLprice = HistoryOrderGetDouble(entryOrderTicket, ORDER_SL);
   }
   if(startTime > 0)
   {
      if(sentTime <= 0 && entryOrderTicket > 0)
         sentTime = FalgoPendingOrderSentTimeFromTicket(entryOrderTicket, startTime);
      sentTime = FalgoResolveTradeSentTime(sentTime, 0, startTime);
   }
   if(startTime > 0)
      BreakdownResolveBrokerTpSlForLifetimeLog(algoNumber, startTime, plannedPrice, realSLprice, realTPprice);
   if(!IsBreakdownFamilyAlgoNumber(algoNumber) || startTime <= 0)
      return;

   if(!gotOpenRec)
      FatalError(StringFormat("BreakdownLogTradeClosedLifetime: no open lifetime positionId=%I64u magic=%I64d startTime=%s",
         positionId, entryMagic, TimeToString(startTime, TIME_DATE | TIME_SECONDS)));

   double closePrice = closePriceIn;
   if(closePrice <= 0.0 && HistorySelectByPosition((long)positionId))
   {
      for(int j = HistoryDealsTotal() - 1; j >= 0; j--)
      {
         const ulong dealTicket = HistoryDealGetTicket(j);
         if(dealTicket == 0)
            continue;
         if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY) != DEAL_ENTRY_OUT)
            continue;
         closePrice = HistoryDealGetDouble(dealTicket, DEAL_PRICE);
         break;
      }
   }

   const datetime eventTime = (closeTime > 0 ? closeTime : g_lastTimer1Time);
   const double lifetimeHours = (double)MathMax(0, eventTime - startTime) / 3600.0;
   string closeReason = pendingCloseReason;
   if(closeReason == "")
      closeReason = BreakdownTradeLifetimeCloseReasonFromExit(dealReason, positionId, entryMagic, startTime);
   double mfePts = 0.0;
   double maePts = 0.0;
   bool hasMfeMae = false;
   if(gotOpenRec)
   {
      mfePts = openRec.mfePts;
      maePts = openRec.maePts;
      hasMfeMae = openRec.mfeMaeInitialized;
      FalgoLifetimeResolveRolloverForClose(startTime, eventTime, openRec.rolloverWedDayStart,
         openRec.withRolloverFee, openRec.rolloverPricediff, withRolloverFee, rolloverPricediff);
      FalgoBtPushClosedStats(entryMagic, startTime, openRec.mfePts, openRec.maePts, openRec.maeFirstWindowPts,
         openRec.mfeCandle1Based, openRec.maeCandle1Based, openRec.closeDecisionReason, openRec.closeDecisionDetail,
         withRolloverFee, rolloverPricediff);
   }
   if(bigflipper_log_breakdown_trade_lifetime)
   {
      BreakdownStashGatesCloseTelemetry(algoNumber, eventTime, entryMagic, startTime);
      BreakdownAppendTradeLifetimeLogRow(algoNumber, eventTime, startTime, "trade closed", closeReason,
         plannedPrice, startPrice, realSLprice, realTPprice, closePrice, lifetimeHours,
         mfePts, maePts, hasMfeMae, withRolloverFee, rolloverPricediff, tradeCustomId);
      BreakdownBenchmarkAllAlgosAccumulateClose(algoNumber, startPrice, closePrice, lifetimeHours,
         mfePts, maePts, hasMfeMae, rolloverPricediff);
   }
   FalgoAppendClosedTradeToAllDaysSummaryFromLifetime(positionId, entryMagic, sentTime, startTime, eventTime,
      startPrice, closePrice, dealReason, closeProfitIn, withRolloverFee, rolloverPricediff, plannedPrice, tradeCustomId);
}

//+------------------------------------------------------------------+
string TimeAlgoTradeLifetimeRunLogFileName(const int algoNumber)
{
   return "timealgo" + IntegerToString(algoNumber) + "_alltrades_log.csv";
}

//+------------------------------------------------------------------+
string TimeAlgoBenchmarkAllAlgosFileName()
{
   return "benchmark_all_algos_time.csv";
}

//+------------------------------------------------------------------+
string TimeAlgoEntryScheduleLogCol(const TimeAlgoDef &ta)
{
   return IntegerToString(ta.entry_hour) + ":" + StringFormat("%02d", ta.entry_minute);
}

//+------------------------------------------------------------------+
void TimeAlgoBenchmarkAllAlgosReset()
{
   for(int i = 0; i < TIME_ALGO_REGISTRY_MAX; i++)
   {
      g_timeAlgoBenchmarkAcc[i].tradesClosed = 0;
      g_timeAlgoBenchmarkAcc[i].winsWithRoll = 0;
      g_timeAlgoBenchmarkAcc[i].lossesWithRoll = 0;
      g_timeAlgoBenchmarkAcc[i].sumPriceDiff = 0.0;
      g_timeAlgoBenchmarkAcc[i].sumPriceDiffWithRoll = 0.0;
      g_timeAlgoBenchmarkAcc[i].sumMfePts = 0.0;
      g_timeAlgoBenchmarkAcc[i].sumMaePts = 0.0;
      g_timeAlgoBenchmarkAcc[i].sumMfePtsWithRoll = 0.0;
      g_timeAlgoBenchmarkAcc[i].sumMaePtsWithRoll = 0.0;
      g_timeAlgoBenchmarkAcc[i].telCount = 0;
      g_timeAlgoBenchmarkAcc[i].sumLifetimeHours = 0.0;
   }
}

//+------------------------------------------------------------------+
void TimeAlgoBenchmarkAllAlgosWrite()
{
   if(!bigflipper_log_time_algo_trade_lifetime)
      return;

   int fh = FileOpen(TimeAlgoBenchmarkAllAlgosFileName(), FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ | FILE_SHARE_WRITE);
   FalgoFatalIfFileOpenFailed(TimeAlgoBenchmarkAllAlgosFileName(), fh);

   FileWrite(fh, "algo_id", "entry_schedule", "trades_closed",
      "wins_with_roll", "losses_with_roll", "win_rate_pct_with_roll",
      "sum_priceDiff", "avg_priceDiff",
      "sum_priceDiff_with_roll", "avg_priceDiff_with_roll",
      "avg_mfe_pts", "avg_mae_pts", "avg_mfe_pts_with_roll", "avg_mae_pts_with_roll",
      "avg_lifetime_hours", "sum_lifetime_minutes", "sum_lifetime_hours", "sum_lifetime_days",
      "pricediff_vs_hours_ratio", "pricediff_vs_hours_ratio_with_roll");

   for(int i = 0; i < g_timeAlgoCount; i++)
   {
      const int algoNumber = g_timeAlgos[i].algo_id;
      const int slotIdx = TimeAlgoSlotIndexByAlgoId(algoNumber);
      if(slotIdx < 0)
         continue;
      const TimeAlgoBenchmarkAcc acc = g_timeAlgoBenchmarkAcc[slotIdx];
      const int n = acc.tradesClosed;
      const double avgPriceDiff = (n > 0) ? acc.sumPriceDiff / (double)n : 0.0;
      const double avgPriceDiffWithRoll = (n > 0) ? acc.sumPriceDiffWithRoll / (double)n : 0.0;
      const double winRateWithRoll = (n > 0) ? (100.0 * (double)acc.winsWithRoll / (double)n) : 0.0;
      const double avgMfe = (acc.telCount > 0) ? acc.sumMfePts / (double)acc.telCount : 0.0;
      const double avgMae = (acc.telCount > 0) ? acc.sumMaePts / (double)acc.telCount : 0.0;
      const double avgMfeWithRoll = (acc.telCount > 0) ? acc.sumMfePtsWithRoll / (double)acc.telCount : 0.0;
      const double avgMaeWithRoll = (acc.telCount > 0) ? acc.sumMaePtsWithRoll / (double)acc.telCount : 0.0;
      const double avgLifetime = (n > 0) ? acc.sumLifetimeHours / (double)n : 0.0;
      const double sumLifetimeMinutes = acc.sumLifetimeHours * 60.0;
      const double sumLifetimeDays = acc.sumLifetimeHours / 24.0;
      const string pricediffVsHoursRatio = (acc.sumLifetimeHours > 0.0)
         ? DoubleToString(acc.sumPriceDiff / acc.sumLifetimeHours, 4) : "";
      const string pricediffVsHoursRatioWithRoll = (acc.sumLifetimeHours > 0.0)
         ? DoubleToString(acc.sumPriceDiffWithRoll / acc.sumLifetimeHours, 4) : "";

      FileWrite(fh,
         IntegerToString(algoNumber),
         TimeAlgoEntryScheduleLogCol(g_timeAlgos[slotIdx]),
         IntegerToString(n),
         IntegerToString(acc.winsWithRoll),
         IntegerToString(acc.lossesWithRoll),
         DoubleToString(winRateWithRoll, 2),
         DoubleToString(acc.sumPriceDiff, _Digits),
         DoubleToString(avgPriceDiff, _Digits),
         DoubleToString(acc.sumPriceDiffWithRoll, _Digits),
         DoubleToString(avgPriceDiffWithRoll, _Digits),
         (acc.telCount > 0 ? DoubleToString(avgMfe, 1) : ""),
         (acc.telCount > 0 ? DoubleToString(avgMae, 1) : ""),
         (acc.telCount > 0 ? DoubleToString(avgMfeWithRoll, 1) : ""),
         (acc.telCount > 0 ? DoubleToString(avgMaeWithRoll, 1) : ""),
         (n > 0 ? DoubleToString(avgLifetime, 1) : ""),
         (n > 0 ? DoubleToString(sumLifetimeMinutes, 1) : ""),
         (n > 0 ? DoubleToString(acc.sumLifetimeHours, 1) : ""),
         (n > 0 ? DoubleToString(sumLifetimeDays, 1) : ""),
         pricediffVsHoursRatio,
         pricediffVsHoursRatioWithRoll);
   }
   FileClose(fh);
}

//+------------------------------------------------------------------+
void TimeAlgoBenchmarkAllAlgosAccumulateClose(const int algoNumber, const double startPrice, const double endPrice,
   const double lifetimeHours, const double mfePts, const double maePts, const bool hasTel,
   const double rolloverPricediff = 0.0)
{
   if(!bigflipper_log_time_algo_trade_lifetime || startPrice <= 0.0 || endPrice <= 0.0)
      return;
   const int slotIdx = TimeAlgoSlotIndexByAlgoId(algoNumber);
   if(slotIdx < 0)
      return;

   TimeAlgoBenchmarkAcc acc = g_timeAlgoBenchmarkAcc[slotIdx];
   const double rollCost = MathMax(0.0, rolloverPricediff);
   const double priceDiff = endPrice - startPrice;
   const double priceDiffWithRoll = priceDiff - rollCost;
   acc.tradesClosed++;
   acc.sumPriceDiff += priceDiff;
   acc.sumPriceDiffWithRoll += priceDiffWithRoll;
   acc.sumLifetimeHours += lifetimeHours;
   if(priceDiffWithRoll > 0.0)
      acc.winsWithRoll++;
   else if(priceDiffWithRoll < 0.0)
      acc.lossesWithRoll++;
   if(hasTel)
   {
      acc.sumMfePts += mfePts;
      acc.sumMaePts += maePts;
      acc.sumMfePtsWithRoll += mfePts - rollCost;
      acc.sumMaePtsWithRoll += maePts - rollCost;
      acc.telCount++;
   }
   g_timeAlgoBenchmarkAcc[slotIdx] = acc;
   TimeAlgoBenchmarkAllAlgosWrite();
}

//+------------------------------------------------------------------+
void TimeAlgoResetTradeLifetimeRunLogsOnInit()
{
   TimeAlgoBenchmarkAllAlgosReset();
   for(int i = 0; i < TIME_ALGO_REGISTRY_MAX; i++)
      g_timeAlgoNextTradeCustomId[i] = 0;
   if(!bigflipper_log_time_algo_trade_lifetime)
      return;
   for(int i = 0; i < g_timeAlgoCount; i++)
   {
      const int algoNumber = g_timeAlgos[i].algo_id;
      if(!IsTimeFamilyAlgoNumber(algoNumber))
         continue;
      const string fname = TimeAlgoTradeLifetimeRunLogFileName(algoNumber);
      int fh = FileOpen(fname, FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ | FILE_SHARE_WRITE);
      FalgoFatalIfFileOpenFailed(fname, fh);
      BreakdownWriteTradeLifetimeRunLogHeader(fh);
      FileClose(fh);
   }
   TimeAlgoBenchmarkAllAlgosWrite();
}

//+------------------------------------------------------------------+
int TimeAlgoRegisterOpenTradeLifetime(const ulong positionId, const int algoNumber,
   const datetime startTime, const double plannedPrice, const double startPrice)
{
   if(positionId == 0 || algoNumber <= 0 || startTime <= 0)
   {
      FatalError(StringFormat("TimeAlgoRegisterOpenTradeLifetime: invalid args positionId=%I64u algo=%d startTime=%s",
         positionId, algoNumber, TimeToString(startTime, TIME_DATE | TIME_SECONDS)));
      return -1;
   }
   for(int i = 0; i < TIME_ALGO_OPEN_LIFETIME_MAX; i++)
   {
      if(g_timeAlgoOpenLifetime[i].active && g_timeAlgoOpenLifetime[i].positionId == positionId)
      {
         g_timeAlgoOpenLifetime[i].algoNumber = algoNumber;
         g_timeAlgoOpenLifetime[i].startTime = startTime;
         g_timeAlgoOpenLifetime[i].plannedPrice = plannedPrice;
         g_timeAlgoOpenLifetime[i].startPrice = startPrice;
         FalgoLifetimeEnsureRolloverState(startTime, g_timeAlgoOpenLifetime[i].rolloverWedDayStart,
            g_timeAlgoOpenLifetime[i].withRolloverFee, g_timeAlgoOpenLifetime[i].rolloverPricediff);
         return g_timeAlgoOpenLifetime[i].tradeCustomId;
      }
   }
   int tradeCustomId = 0;
   const int algoIdx = TimeAlgoSlotIndexByAlgoId(algoNumber);
   if(algoIdx >= 0)
   {
      g_timeAlgoNextTradeCustomId[algoIdx]++;
      tradeCustomId = g_timeAlgoNextTradeCustomId[algoIdx];
   }
   for(int i = 0; i < TIME_ALGO_OPEN_LIFETIME_MAX; i++)
   {
      if(!g_timeAlgoOpenLifetime[i].active)
      {
         ZeroMemory(g_timeAlgoOpenLifetime[i]);
         g_timeAlgoOpenLifetime[i].positionId = positionId;
         g_timeAlgoOpenLifetime[i].algoNumber = algoNumber;
         g_timeAlgoOpenLifetime[i].tradeCustomId = tradeCustomId;
         g_timeAlgoOpenLifetime[i].startTime = startTime;
         g_timeAlgoOpenLifetime[i].plannedPrice = plannedPrice;
         g_timeAlgoOpenLifetime[i].startPrice = startPrice;
         g_timeAlgoOpenLifetime[i].active = true;
         FalgoLifetimePosMapInsert(positionId, i, g_timeAlgoLifetimePosMapKey, g_timeAlgoLifetimePosMapSlot,
            FALGO_LIFETIME_POS_MAP_BUCKETS);
         FalgoLifetimeEnsureRolloverState(startTime, g_timeAlgoOpenLifetime[i].rolloverWedDayStart,
            g_timeAlgoOpenLifetime[i].withRolloverFee, g_timeAlgoOpenLifetime[i].rolloverPricediff);
         return tradeCustomId;
      }
   }
   FatalError(StringFormat("TimeAlgoRegisterOpenTradeLifetime: full (%d); raise TIME_ALGO_OPEN_LIFETIME_MAX",
      TIME_ALGO_OPEN_LIFETIME_MAX));
   return -1;
}

//+------------------------------------------------------------------+
bool TimeAlgoTakeOpenTradeLifetime(const ulong positionId, FalgoSecretTpLifetimeRec &outRec)
{
   ZeroMemory(outRec);
   for(int i = 0; i < TIME_ALGO_OPEN_LIFETIME_MAX; i++)
   {
      if(g_timeAlgoOpenLifetime[i].active && g_timeAlgoOpenLifetime[i].positionId == positionId)
      {
         outRec = g_timeAlgoOpenLifetime[i];
         g_timeAlgoOpenLifetime[i].active = false;
         TimeAlgoOpenLifetimePosMapRebuild();
         return true;
      }
   }
   return false;
}

//+------------------------------------------------------------------+
void TimeAlgoRememberPendingCloseReason(const ulong positionId, const string reason)
{
   if(positionId == 0 || reason == "")
      return;
   for(int i = 0; i < TIME_ALGO_OPEN_LIFETIME_MAX; i++)
   {
      if(g_timeAlgoOpenLifetime[i].active && g_timeAlgoOpenLifetime[i].positionId == positionId)
         g_timeAlgoOpenLifetime[i].pendingCloseReason = reason;
   }
}

//+------------------------------------------------------------------+
void TimeAlgoRememberCloseDecision(const ulong positionId, const string decision, const string detail)
{
   if(positionId == 0)
      return;
   for(int i = 0; i < TIME_ALGO_OPEN_LIFETIME_MAX; i++)
   {
      if(g_timeAlgoOpenLifetime[i].active && g_timeAlgoOpenLifetime[i].positionId == positionId)
      {
         if(decision != "")
            g_timeAlgoOpenLifetime[i].closeDecisionReason = decision;
         if(detail != "")
            g_timeAlgoOpenLifetime[i].closeDecisionDetail = detail;
      }
   }
}

//+------------------------------------------------------------------+
void LevelAlgoRememberPendingCloseReason(const ulong positionId, const string reason)
{
   if(positionId == 0 || reason == "")
      return;
   for(int i = 0; i < LEVEL_ALGO_OPEN_LIFETIME_MAX; i++)
   {
      if(g_levelAlgoOpenLifetime[i].active && g_levelAlgoOpenLifetime[i].positionId == positionId)
         g_levelAlgoOpenLifetime[i].pendingCloseReason = reason;
   }
}

//+------------------------------------------------------------------+
void LevelAlgoRememberCloseDecision(const ulong positionId, const string decision, const string detail)
{
   if(positionId == 0)
      return;
   for(int i = 0; i < LEVEL_ALGO_OPEN_LIFETIME_MAX; i++)
   {
      if(g_levelAlgoOpenLifetime[i].active && g_levelAlgoOpenLifetime[i].positionId == positionId)
      {
         if(decision != "")
            g_levelAlgoOpenLifetime[i].closeDecisionReason = decision;
         if(detail != "")
            g_levelAlgoOpenLifetime[i].closeDecisionDetail = detail;
      }
   }
}

//+------------------------------------------------------------------+
int TimeAlgoTradesTodayForLog(const int algoNumber)
{
   const int idx = TimeAlgoSlotIndexByAlgoId(algoNumber);
   if(idx < 0)
      return 0;
   return g_timeAlgoDayTradesToday[idx];
}

//+------------------------------------------------------------------+
int TimeAlgoTradesAllForLog(const int algoNumber)
{
   const int idx = TimeAlgoSlotIndexByAlgoId(algoNumber);
   if(idx < 0)
      return 0;
   return g_timeAlgoTradesAll[idx];
}

//+------------------------------------------------------------------+
string TimeAlgoTradeLifetimeCloseReasonFromExit(const ENUM_DEAL_REASON dealReason,
   const ulong positionId, const long entryMagic, const datetime startTime)
{
   if(dealReason == DEAL_REASON_TP)
      return "realTP";
   if(dealReason == DEAL_REASON_SL)
      return "realSL";
   return "";
}

//+------------------------------------------------------------------+
void TimeAlgoAppendTradeLifetimeLogRow(const int algoNumber, const datetime eventTime, const datetime startTime,
   const string eventType, const string closeReason, const double plannedPrice, const double startPrice,
   const double endPrice, const double lifetimeHours,
   const double mfePts = 0.0, const double maePts = 0.0, const bool fillMaeMfe = false,
   const bool withRolloverFee = false, const double rolloverPricediff = 0.0, const int tradeCustomId = 0)
{
   if(!IsTimeFamilyAlgoNumber(algoNumber))
      return;

   const int tradesToday = TimeAlgoTradesTodayForLog(algoNumber);
   const int concurrentOpen = TimeAlgoConcurrentOpenTradesForLog(algoNumber);
   const int tradesAll = TimeAlgoTradesAllForLog(algoNumber);

   if(bigflipper_log_time_algo_trade_lifetime)
      FalgoAppendAllTradesLifetimeLogRowToFile(TimeAlgoTradeLifetimeRunLogFileName(algoNumber),
         eventTime, startTime, eventType, closeReason, plannedPrice, startPrice, 0.0, 0.0, endPrice,
         lifetimeHours, tradeCustomId, tradesToday, concurrentOpen, tradesAll, mfePts, maePts, fillMaeMfe,
         withRolloverFee, rolloverPricediff);
}

//+------------------------------------------------------------------+
void TimeAlgoLogTradeOpenedLifetime(const ulong positionId, const long magic, const datetime fillTime,
   const double fillPrice, const ulong orderTicket)
{
   if(!IsTimeFamilyCompositeMagic(magic))
      return;
   const int algoNumber = AlgoFamilyMagicNumber(magic);
   if(!IsTimeFamilyAlgoNumber(algoNumber))
      return;

   double plannedPrice = 0.0;
   if(orderTicket > 0 && HistoryOrderSelect(orderTicket))
      plannedPrice = HistoryOrderGetDouble(orderTicket, ORDER_PRICE_OPEN);
   if(plannedPrice <= 0.0)
      plannedPrice = fillPrice;

   const double startPrice = (fillPrice > 0.0 ? fillPrice : plannedPrice);
   const datetime startTime = (fillTime > 0 ? fillTime : g_lastTimer1Time);
   const int tradeCustomId = TimeAlgoRegisterOpenTradeLifetime(positionId, algoNumber, startTime, plannedPrice, startPrice);
   const int lifeIdx = TimeAlgoOpenLifetimeSlotByPositionId(positionId);
   if(lifeIdx >= 0)
      TimeAlgoHydrateLifetimeSecretTpFromMagic(lifeIdx, positionId, magic);
   const int algoIdx = TimeAlgoSlotIndexByAlgoId(algoNumber);
   if(algoIdx >= 0)
      g_timeAlgoTradesAll[algoIdx]++;
   if(bigflipper_log_time_algo_trade_lifetime)
      TimeAlgoAppendTradeLifetimeLogRow(algoNumber, startTime, startTime, "trade opened", "",
         plannedPrice, startPrice, 0.0, 0.0, 0.0, 0.0, false, false, 0.0, tradeCustomId);
}

//+------------------------------------------------------------------+
void TimeAlgoLogTradeClosedLifetime(const ulong positionId, const long entryMagic, const datetime closeTime,
   const double closePriceIn, const ENUM_DEAL_REASON dealReason, const double closeProfitIn)
{
   if(!IsTimeFamilyCompositeMagic(entryMagic))
      return;

   FalgoSecretTpLifetimeRec openRec;
   datetime startTime = 0;
   double plannedPrice = 0.0;
   double startPrice = 0.0;
   string pendingCloseReason = "";
   bool withRolloverFee = false;
   double rolloverPricediff = 0.0;
   int tradeCustomId = 0;
   int algoNumber = AlgoFamilyMagicNumber(entryMagic);
   const bool gotOpenRec = TimeAlgoTakeOpenTradeLifetime(positionId, openRec);
   if(gotOpenRec)
   {
      algoNumber = openRec.algoNumber;
      tradeCustomId = openRec.tradeCustomId;
      startTime = openRec.startTime;
      plannedPrice = openRec.plannedPrice;
      startPrice = openRec.startPrice;
      pendingCloseReason = openRec.pendingCloseReason;
      withRolloverFee = openRec.withRolloverFee;
      rolloverPricediff = openRec.rolloverPricediff;
   }
   else if(HistorySelectByPosition((long)positionId))
   {
      for(int j = 0; j < HistoryDealsTotal(); j++)
      {
         const ulong dealTicket = HistoryDealGetTicket(j);
         if(dealTicket == 0)
            continue;
         if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY) != DEAL_ENTRY_IN)
            continue;
         startTime = (datetime)HistoryDealGetInteger(dealTicket, DEAL_TIME);
         startPrice = HistoryDealGetDouble(dealTicket, DEAL_PRICE);
         plannedPrice = startPrice;
         if(!IsTimeFamilyAlgoNumber(algoNumber))
            algoNumber = AlgoFamilyMagicNumber(HistoryDealGetInteger(dealTicket, DEAL_MAGIC));
         break;
      }
   }
   if(!IsTimeFamilyAlgoNumber(algoNumber) || startTime <= 0)
      return;

   if(!gotOpenRec)
      FatalError(StringFormat("TimeAlgoLogTradeClosedLifetime: no open lifetime positionId=%I64u magic=%I64d startTime=%s",
         positionId, entryMagic, TimeToString(startTime, TIME_DATE | TIME_SECONDS)));

   double closePrice = closePriceIn;
   if(closePrice <= 0.0 && HistorySelectByPosition((long)positionId))
   {
      for(int j = HistoryDealsTotal() - 1; j >= 0; j--)
      {
         const ulong dealTicket = HistoryDealGetTicket(j);
         if(dealTicket == 0)
            continue;
         if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY) != DEAL_ENTRY_OUT)
            continue;
         closePrice = HistoryDealGetDouble(dealTicket, DEAL_PRICE);
         break;
      }
   }

   const datetime eventTime = (closeTime > 0 ? closeTime : g_lastTimer1Time);
   const double lifetimeHours = (double)MathMax(0, eventTime - startTime) / 3600.0;
   string closeReason = pendingCloseReason;
   if(closeReason == "")
      closeReason = TimeAlgoTradeLifetimeCloseReasonFromExit(dealReason, positionId, entryMagic, startTime);
   double mfePts = 0.0;
   double maePts = 0.0;
   bool hasMfeMae = false;
   if(gotOpenRec)
   {
      mfePts = openRec.mfePts;
      maePts = openRec.maePts;
      hasMfeMae = openRec.mfeMaeInitialized;
      FalgoLifetimeResolveRolloverForClose(startTime, eventTime, openRec.rolloverWedDayStart,
         openRec.withRolloverFee, openRec.rolloverPricediff, withRolloverFee, rolloverPricediff);
      FalgoBtPushClosedStats(entryMagic, startTime, openRec.mfePts, openRec.maePts, openRec.maeFirstWindowPts,
         openRec.mfeCandle1Based, openRec.maeCandle1Based, openRec.closeDecisionReason, openRec.closeDecisionDetail,
         withRolloverFee, rolloverPricediff);
   }
   if(bigflipper_log_time_algo_trade_lifetime)
   {
      TimeAlgoAppendTradeLifetimeLogRow(algoNumber, eventTime, startTime, "trade closed", closeReason,
         plannedPrice, startPrice, closePrice, lifetimeHours,
         mfePts, maePts, hasMfeMae, withRolloverFee, rolloverPricediff, tradeCustomId);
      TimeAlgoBenchmarkAllAlgosAccumulateClose(algoNumber, startPrice, closePrice, lifetimeHours,
         mfePts, maePts, hasMfeMae, rolloverPricediff);
   }
   FalgoAppendClosedTradeToAllDaysSummaryFromLifetime(positionId, entryMagic, startTime, startTime, eventTime,
      startPrice, closePrice, dealReason, closeProfitIn, withRolloverFee, rolloverPricediff, plannedPrice, tradeCustomId);
}

//+------------------------------------------------------------------+
string FalgoEodTradeResultsDailyCsvName(const string dateStr, const int algoNumber)
{
   if(IsBreakdownFamilyAlgoNumber(algoNumber))
      return dateStr + "_summaryZ_tradeResults_ALL_Day_bdalgo" + IntegerToString(algoNumber) + ".csv";
   return dateStr + "_summaryZ_tradeResults_ALL_Day_algo" + IntegerToString(algoNumber) + ".csv";
}

//+------------------------------------------------------------------+
bool FalgoAlgoRegisteredForEodTradeResults(const int algoNumber)
{
   return (AlgoSlotIndexByAlgoId(algoNumber) >= 0 || BreakdownAlgoSlotIndexByAlgoId(algoNumber) >= 0);
}

//+------------------------------------------------------------------+
void RebuildAlgoSlotsRegistry()
{
   g_algoCount = 0;
   const int n = ArraySize(g_algoRegistryIds);
   for(int i = 0; i < n; i++)
   {
      if(g_algoCount >= ALGO_FAMILY_REGISTRY_MAX)
         FatalError("RebuildAlgoSlotsRegistry: ALGO_FAMILY_REGISTRY_MAX exceeded");
      g_algos[g_algoCount].algo_id = g_algoRegistryIds[i];
      g_algos[g_algoCount].trades_short = false;
      g_algoCount++;
   }
   if(ALGO_FAMILY_REGISTRY_MAX > g_algoCount + ALGO_FAMILY_REGISTRY_MAX_HEADROOM)
      FatalError(StringFormat(
         "ALGO_FAMILY_REGISTRY_MAX=%d exceeds wired algo count %d by more than %d — lower #define ALGO_FAMILY_REGISTRY_MAX (comment //algobookmarkMAX)",
         ALGO_FAMILY_REGISTRY_MAX, g_algoCount, ALGO_FAMILY_REGISTRY_MAX_HEADROOM));
}

//+------------------------------------------------------------------+
int AlgoSlotIndexByAlgoId(const int algoNumber)
{
   for(int i = 0; i < g_algoCount; i++)
   {
      if(g_algos[i].algo_id == algoNumber)
         return i;
   }
   return -1;
}

//+------------------------------------------------------------------+
int AlgoFamilySlotArrayIndex(const int algoNumber)
{
   return AlgoSlotIndexByAlgoId(algoNumber);
}

//+------------------------------------------------------------------+
bool AlgoSlotTradesShort(const int algoNumber)
{
   const int idx = AlgoSlotIndexByAlgoId(algoNumber);
   if(idx < 0)
      return false;
   return g_algos[idx].trades_short;
}

//+------------------------------------------------------------------+
bool AlgoProfileEnabled(const int algoNumber)
{
   if(IsBreakdownFamilyAlgoNumber(algoNumber))
   {
      const int idx = BreakdownAlgoSlotIndexByAlgoId(algoNumber);
      if(idx < 0)
         return false;
      return g_breakdownAlgos[idx].enabled;
   }
   if(IsTimeFamilyAlgoNumber(algoNumber))
   {
      const int idx = TimeAlgoSlotIndexByAlgoId(algoNumber);
      if(idx < 0)
         return false;
      return g_timeAlgos[idx].enabled;
   }
   const int idx = AlgoSlotIndexByAlgoId(algoNumber);
   if(idx < 0)
      return false;
   return g_algos[idx].enabled;
}

//+------------------------------------------------------------------+
bool AlgoFamilyBlocksPlacementOnOpenOrPending()
{
   return g_algoShared.blockPlacementIfFamilyOpenOrPending;
}

//+------------------------------------------------------------------+
bool AlgoLoadTuneForAlgo(const int algoNumber, AlgoPerAlgoTune &outTune)
{
   if(IsBreakdownFamilyAlgoNumber(algoNumber))
      return false;
   const int idx = AlgoSlotIndexByAlgoId(algoNumber);
   if(idx < 0)
      return false;
   outTune = g_algos[idx].tune;
   return true;
}

//+------------------------------------------------------------------+
int AlgoFamilyMagicNumber(const long magic)
{
   if(!FalgoIsCompositeMagicLong(magic))
      return -1;
   return (int)(magic / FalgoCompositeMagicTailScale());
}

//+------------------------------------------------------------------+
bool IsShortAlgoCompositeMagic(const long magic)
{
   return AlgoSlotTradesShort(AlgoFamilyMagicNumber(magic));
}

//+------------------------------------------------------------------+
bool IsAlgoCompositeMagic(const long magic, const int algoNumber)
{
   return (AlgoFamilyMagicNumber(magic) == algoNumber);
}

//+------------------------------------------------------------------+
bool IsAnyAlgoFamilyCompositeMagic(const long magic)
{
   const int algoNumber = AlgoFamilyMagicNumber(magic);
   return IsBreakdownFamilyAlgoNumber(algoNumber) || IsTimeFamilyAlgoNumber(algoNumber) || IsLevelFamilyAlgoNumber(algoNumber);
}

//+------------------------------------------------------------------+
//| (date)_algo{N}_{suffix}.csv — e.g. 20260511_algo10_gates_per_minute.csv |
//+------------------------------------------------------------------+
string AlgoFamilyCsvFileName(const string dateStr, const int algoNumber, const string suffix)
{
   return dateStr + "_algo" + IntegerToString(algoNumber) + "_" + suffix + ".csv";
}


//+------------------------------------------------------------------+
//| Algo family (algo 10000000..99999999): Falgo* helpers, pipelines, telemetry, EOD logs (inline below). |
//+------------------------------------------------------------------+


//--- Falgo magic layout (18 decimal digits; index 0 = digit 1)
//| AAAAAAAA | D | OO | SSSS | R | uu |
//  SSSS = secret TP points above planned open (round(secretTp - plannedPrice), 0000=none)
//  OO   = breakdown: plan offset tenths; time algo: greenguard pricediff tenths (e.g. 8.0 -> 80)
//  R    = custom rule switch map (0..9). breakdown: always 0. time/level: 0=anytime; 1=14:30-15:29; 2=02:00-03:00
//  uu   = level magic slot %02d (00=RTHO, 01=PDC, 10..35 weekly, 50..80 daily)
#define FALGO_MAGIC_INDEX_ALGO            0   // 8-digit algo id (10000000..99999999)
#define FALGO_MAGIC_INDEX_DIRECTION       8   // 1|2|3|4 long/short variants
#define FALGO_MAGIC_LENGTH_DIRECTION      1
#define FALGO_MAGIC_INDEX_OFFSET          9   // %02d tenths (long or short offset for this plan)
#define FALGO_MAGIC_LENGTH_OFFSET         2
#define FALGO_MAGIC_INDEX_SECRET_TP       11  // %04d points above planned open price
#define FALGO_MAGIC_LENGTH_SECRET_TP      4
#define FALGO_MAGIC_INDEX_RULE_SWITCH     15  // %01d custom rule switch map (0=default)
#define FALGO_MAGIC_LENGTH_RULE_SWITCH    1
#define FALGO_MAGIC_INDEX_TAIL_RESERVED   16  // %02d reserved (build as 00)
#define FALGO_MAGIC_LENGTH_TAIL_RESERVED  2
#define FALGO_MAGIC_INDEX_UNUSED          FALGO_MAGIC_INDEX_RULE_SWITCH   // legacy alias: R+uu tail block
#define FALGO_MAGIC_LENGTH_UNUSED         (FALGO_MAGIC_LENGTH_RULE_SWITCH + FALGO_MAGIC_LENGTH_TAIL_RESERVED)

#define FALGO_MAGIC_LEVEL_SLOT_RTHO          0   // todayRTHopen
#define FALGO_MAGIC_LEVEL_SLOT_PDRTHCLOSE    1   // PDrthClose (prior day RTH close)
#define FALGO_MAGIC_LEVEL_SLOT_BREAKDOWN     2   // breakdown midpoint (no level row)
#define FALGO_MAGIC_LEVEL_SLOT_TIME_ALGO     3   // scheduled time-algo market entry (no level row)
#define FALGO_MAGIC_LEVEL_SLOT_TERTIARY      0   // alias: todayRTHopen
#define FALGO_MAGIC_LEVEL_SLOT_WEEKLY_MIN   10
#define FALGO_MAGIC_LEVEL_SLOT_WEEKLY_MAX   35
#define FALGO_MAGIC_LEVEL_SLOT_WEEKLY_PIVOT 20
#define FALGO_MAGIC_LEVEL_SLOT_DAILY_MIN    50
#define FALGO_MAGIC_LEVEL_SLOT_DAILY_MAX    80
#define FALGO_MAGIC_LEVEL_SLOT_DAILY_PIVOT  60

//+------------------------------------------------------------------+
double AlgoExtraOffsetForDirection(const int direction)
{
   if(direction == FALGO_DIRECTION_LONG_LIMIT || direction == FALGO_DIRECTION_LONG_ALT)
      return g_algoShared.extra_offset_all_longs;
   if(direction == FALGO_DIRECTION_SHORT_LIMIT || direction == FALGO_DIRECTION_SHORT_ALT)
      return g_algoShared.extra_offset_all_shorts;
   return 0.0;
}

//+------------------------------------------------------------------+
bool AlgoPlacementParamsForAlgo(const int algoNumber, const int direction, double &offsetPoints, double &proximityLimit, int &expirationMin)
{
   const int idx = AlgoSlotIndexByAlgoId(algoNumber);
   if(idx < 0)
      return false;
   offsetPoints = g_algos[idx].levelOffset + AlgoExtraOffsetForDirection(direction);
   proximityLimit = g_algos[idx].priceProximity;
   expirationMin = g_algos[idx].expiry_minutes;
   return true;
}

struct BannedRangeMinutes { int startMin; int endMin; };
BannedRangeMinutes g_falgoBannedRanges[FALGO_BANNED_RANGES_MAX];
int g_falgoBannedRangeCount = 0;
BannedRangeMinutes g_timeAlgoBannedRanges[FALGO_BANNED_RANGES_MAX];
BannedRangeMinutes g_levelAlgoBannedRanges[FALGO_BANNED_RANGES_MAX];
int g_timeAlgoBannedRangeCount = 0;
datetime g_falgoPlanCountersDayStart = 0;
datetime g_falgoDayTradeCountsDayStart = 0;
int g_algoPlanTradeNumToday[ALGO_FAMILY_REGISTRY_MAX];  // per wired algo (10–15); next plan # = count+1
int g_algoLevelTradeNumByMagicSlot[ALGO_FAMILY_REGISTRY_MAX][FALGO_MAGIC_LEVEL_SLOT_COUNT];
int g_algoDayWins[ALGO_FAMILY_REGISTRY_MAX];
int g_algoDayLosses[ALGO_FAMILY_REGISTRY_MAX];
int g_algoFamilyDayWins = 0;
int g_algoFamilyDayLosses = 0;
double g_algoFamilyDayGrossProfit = 0.0;
double g_algoFamilyDayGrossLossAbs = 0.0;
int g_falgoFamilyLastClosedBarIdx = -1;
bool g_algoFamilyHadCloseThisPipelinePass = false;

//+------------------------------------------------------------------+
datetime FalgoDayStartFromDateStr(const string dateStr)
{
   if(StringLen(dateStr) < 8)
      return 0;
   datetime t = StringToTime(dateStr);
   if(t <= 0)
      t = StringToTime(dateStr + " 00:00");
   if(t <= 0)
      return 0;
   return t - (t % 86400);
}

//+------------------------------------------------------------------+
datetime FalgoCalendarDayStart()
{
   const string activeDateStr = FalgoLevelsActiveDateStrForTime(g_lastTimer1Time > 0 ? g_lastTimer1Time : TimeCurrent());
   const datetime fromActive = FalgoDayStartFromDateStr(activeDateStr);
   if(fromActive != 0)
      return fromActive;
   if(g_lastTimer1Time > 0)
      return g_lastTimer1Time - (g_lastTimer1Time % 86400);
   const datetime t = TimeCurrent();
   if(t > 0)
      return t - (t % 86400);
   return 0;
}

//+------------------------------------------------------------------+
datetime FalgoTradingDayStart()
{
   if(g_m1DayStart != 0)
      return g_m1DayStart;
   return FalgoCalendarDayStart();
}

//+------------------------------------------------------------------+
datetime FalgoDayStartForCounterRebuild()
{
   return FalgoCalendarDayStart();
}

