#define FALGO_DIRECTION_LONG_LIMIT        1
#define FALGO_DIRECTION_SHORT_LIMIT       2
#define FALGO_DIRECTION_LONG_ALT          3
#define FALGO_DIRECTION_SHORT_ALT         4
