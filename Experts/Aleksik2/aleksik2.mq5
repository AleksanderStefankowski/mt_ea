void LevelRebuildRuleChainForSlot(const int slotIdx)
{
   if(slotIdx < 0 || slotIdx >= g_levelAlgoCount)
      return;
   const int algoId = g_levelAlgos[slotIdx].algo_id;
   LevelRuleChainClear(slotIdx);
