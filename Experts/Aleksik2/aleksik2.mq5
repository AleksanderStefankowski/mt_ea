//+------------------------------------------------------------------+
void BreakdownRebuildAllRuleChains()
{
   for(int i = 0; i < g_breakdownAlgoCount; i++)
      BreakdownRebuildRuleChainForSlot(i);
}

//+------------------------------------------------------------------+
//| Level rule engine: ordered rule chains per slot (g_levelAlgos[].rules). |
//+------------------------------------------------------------------+
void LevelRuleChainClear(const int slotIdx)
{
   g_levelAlgos[slotIdx].rule_count = 0;
}

//+------------------------------------------------------------------+
void LevelRuleChainAdd(const int slotIdx, const ENUM_ALGO_RULE ruleId,
                      const int i0 = 0, const int i1 = 0,
                      const double d0 = 0.0, const double d1 = 0.0,
                      const string s0 = "")
{
   if(slotIdx < 0 || slotIdx >= g_levelAlgoCount)
      FatalError("LevelRuleChainAdd: invalid slotIdx");
   if(g_levelAlgos[slotIdx].rule_count >= ALGO_RULES_MAX)
      FatalError(StringFormat("LevelRuleChainAdd: ALGO_RULES_MAX exceeded for algo %d", g_levelAlgos[slotIdx].algo_id));
   const int r = g_levelAlgos[slotIdx].rule_count;
   g_levelAlgos[slotIdx].rules[r].rule_id = ruleId;
   g_levelAlgos[slotIdx].rules[r].i0 = i0;
   g_levelAlgos[slotIdx].rules[r].i1 = i1;
   g_levelAlgos[slotIdx].rules[r].d0 = d0;
   g_levelAlgos[slotIdx].rules[r].d1 = d1;
   g_levelAlgos[slotIdx].rules[r].s0 = s0;
   g_levelAlgos[slotIdx].rule_count++;
}

//+------------------------------------------------------------------+
string LevelRunRulesFirstFail(const int slotIdx, const int barIdx, const double plannedTradePrice)
{
   if(slotIdx < 0 || slotIdx >= g_levelAlgoCount)
      return "unknownAlgo";
   if(barIdx < 0 || barIdx >= g_barsInDay)
      return "invalidBar";
   if(g_levelAlgos[slotIdx].rule_count <= 0)
      return "";
   if(plannedTradePrice <= 0.0)
      return "";
   for(int r = 0; r < g_levelAlgos[slotIdx].rule_count; r++)
   {
      const string f = EvalAlgoRule(g_levelAlgos[slotIdx].algo_id,
         g_levelAlgos[slotIdx].rules[r], barIdx, plannedTradePrice);
      if(f != "")
         return f;
   }
   return "";
}

