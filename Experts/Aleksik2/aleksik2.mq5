//+------------------------------------------------------------------+
string BacktestProfGapPendingBucketSuffix(const int pendingBucket)
{
   switch(pendingBucket)
   {
      case 0:  return "pend0";
      case 1:  return "pend1_20";
      case 2:  return "pend21_100";
      default: return "pend101_plus";
   }
}

//+------------------------------------------------------------------+
string BacktestProfOutsideGapPendingSectionLabel(const int section)
{
   const int pendingBucket = (section - BACKTEST_PROF_OUTSIDE_GAP_BD_OPEN_M1_CLOSE_PEND0) % BACKTEST_PROF_GAP_PENDING_BUCKET_COUNT;
   const string pend = BacktestProfGapPendingBucketSuffix(pendingBucket);
   if(section >= BACKTEST_PROF_OUTSIDE_GAP_BD_OPEN_M1_CLOSE_PEND0
      && section < BACKTEST_PROF_OUTSIDE_GAP_BD_OPEN_STEADY_PEND0)
      return "outside_between_ontimers_bd_open_m1_close_" + pend;
   if(section >= BACKTEST_PROF_OUTSIDE_GAP_BD_OPEN_STEADY_PEND0
      && section < BACKTEST_PROF_OUTSIDE_GAP_TIME_OPEN_M1_CLOSE_PEND0)
      return "outside_between_ontimers_bd_open_steady_sec_" + pend;
   if(section >= BACKTEST_PROF_OUTSIDE_GAP_TIME_OPEN_M1_CLOSE_PEND0
      && section < BACKTEST_PROF_OUTSIDE_GAP_TIME_OPEN_STEADY_PEND0)
      return "outside_between_ontimers_time_open_m1_close_" + pend;
   if(section >= BACKTEST_PROF_OUTSIDE_GAP_TIME_OPEN_STEADY_PEND0
      && section < BACKTEST_PROF_OUTSIDE_GAP_NO_OPEN_PEND0)
      return "outside_between_ontimers_time_open_steady_sec_" + pend;
   return "outside_between_ontimers_" + pend;
}

//+------------------------------------------------------------------+
void BacktestProfZeroBuckets(BacktestProfBucket &buckets[])
{
   for(int i = 0; i < BACKTEST_PROF_SECTION_COUNT; i++)
   {
      buckets[i].totalUs = 0;
      buckets[i].maxUs = 0;
      buckets[i].calls = 0;
   }
}

//+------------------------------------------------------------------+
void BacktestProfAccumulate(const int section, const ulong t0)
{
   if(section < 0 || section >= BACKTEST_PROF_SECTION_COUNT)
      return;
   if(!BacktestProfileEnabled() || !g_backtestProfArmed)
      return;
   const ulong elapsed = GetMicrosecondCount() - t0;
   g_backtestProfRunTotals[section].totalUs += elapsed;
   g_backtestProfRunTotals[section].calls++;
   if(elapsed > g_backtestProfRunTotals[section].maxUs)
      g_backtestProfRunTotals[section].maxUs = elapsed;
   g_backtestProfDayTotals[section].totalUs += elapsed;
   g_backtestProfDayTotals[section].calls++;
   if(elapsed > g_backtestProfDayTotals[section].maxUs)
      g_backtestProfDayTotals[section].maxUs = elapsed;
}

//+------------------------------------------------------------------+
void BacktestProfAccumulateLifecycle(const int section, const ulong t0)
{
   if(section < 0 || section >= BACKTEST_PROF_SECTION_COUNT)
      return;
   if(!BacktestProfileEnabled())
      return;
   const ulong elapsed = GetMicrosecondCount() - t0;
   g_backtestProfRunTotals[section].totalUs += elapsed;
   g_backtestProfRunTotals[section].calls++;
   if(elapsed > g_backtestProfRunTotals[section].maxUs)
      g_backtestProfRunTotals[section].maxUs = elapsed;
   g_backtestProfDayTotals[section].totalUs += elapsed;
   g_backtestProfDayTotals[section].calls++;
   if(elapsed > g_backtestProfDayTotals[section].maxUs)
      g_backtestProfDayTotals[section].maxUs = elapsed;
}

//+------------------------------------------------------------------+
void BacktestProfAccumulateGap(const int section, const ulong elapsed)
{
   if(section < 0 || section >= BACKTEST_PROF_SECTION_COUNT || elapsed == 0)
      return;
   g_backtestProfRunTotals[section].totalUs += elapsed;
   g_backtestProfRunTotals[section].calls++;
   if(elapsed > g_backtestProfRunTotals[section].maxUs)
      g_backtestProfRunTotals[section].maxUs = elapsed;
   g_backtestProfDayTotals[section].totalUs += elapsed;
   g_backtestProfDayTotals[section].calls++;
   if(elapsed > g_backtestProfDayTotals[section].maxUs)
      g_backtestProfDayTotals[section].maxUs = elapsed;
}

//+------------------------------------------------------------------+
void BacktestProfMarkScopeEnd(const int scopeKind = BACKTEST_PROF_SCOPE_ONTIMER)
{
   if(BacktestProfileEnabled())
   {
      g_backtestProfLastScopeKind = scopeKind;
      g_backtestProfLastScopedEndUs = GetMicrosecondCount();
   }
}

//+------------------------------------------------------------------+
int BacktestProfOutsideGapSectionForEntry(const int enteringScopeKind)
{
   if(enteringScopeKind == BACKTEST_PROF_SCOPE_ONDEINIT)
      return BACKTEST_PROF_OUTSIDE_BEFORE_ONDEINIT;
   if(enteringScopeKind == BACKTEST_PROF_SCOPE_ONTRADE)
      return BACKTEST_PROF_OUTSIDE_BETWEEN_ONTIMERS;
   if(enteringScopeKind == BACKTEST_PROF_SCOPE_ONTIMER &&
      g_backtestProfLastScopeKind == BACKTEST_PROF_SCOPE_ONINIT)
      return BACKTEST_PROF_OUTSIDE_AFTER_ONINIT;
   return BACKTEST_PROF_OUTSIDE_BETWEEN_ONTIMERS;
}

//+------------------------------------------------------------------+
bool BacktestProfFamilyHasOpenOnSymbol(const bool breakdownFamily)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!ExtPositionInfo.SelectByIndex(i))
         continue;
      if(ExtPositionInfo.Symbol() != _Symbol)
         continue;
      const long m = ExtPositionInfo.Magic();
      if(breakdownFamily)
      {
         if(IsBreakdownFamilyCompositeMagic(m))
            return true;
      }
      else
      {
         if(IsTimeFamilyCompositeMagic(m))
            return true;
      }
   }
   return false;
}

//+------------------------------------------------------------------+
int BacktestProfPendingOrdersOnSymbol()
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!ExtOrderInfo.SelectByIndex(i))
         continue;
      if(ExtOrderInfo.Symbol() != _Symbol)
         continue;
      count++;
   }
   return count;
}

//+------------------------------------------------------------------+
int BacktestProfGapPendingBucketIndex(const int pendingCount)
{
   if(pendingCount <= 0)
      return 0;
   if(pendingCount <= 20)
      return 1;
   if(pendingCount <= 100)
      return 2;
   return 3;
}

//+------------------------------------------------------------------+
int BacktestProfOutsideGapSectionForOpenState(const bool bdOpen, const bool timeOpen,
   const bool isM1CloseTick, const int pendingBucket)
{
   int base = BACKTEST_PROF_OUTSIDE_GAP_NO_OPEN_PEND0;
   if(bdOpen)
      base = isM1CloseTick
         ? BACKTEST_PROF_OUTSIDE_GAP_BD_OPEN_M1_CLOSE_PEND0
         : BACKTEST_PROF_OUTSIDE_GAP_BD_OPEN_STEADY_PEND0;
   else if(timeOpen)
      base = isM1CloseTick
         ? BACKTEST_PROF_OUTSIDE_GAP_TIME_OPEN_M1_CLOSE_PEND0
         : BACKTEST_PROF_OUTSIDE_GAP_TIME_OPEN_STEADY_PEND0;
   return base + pendingBucket;
}

//+------------------------------------------------------------------+
bool BacktestProfSectionIsOutsideGapPendingBucket(const int section)
{
   return section >= BACKTEST_PROF_OUTSIDE_GAP_BD_OPEN_M1_CLOSE_PEND0
      && section < BACKTEST_PROF_OUTSIDE_GAP_NO_OPEN_PEND0 + BACKTEST_PROF_GAP_PENDING_BUCKET_COUNT;
}

//+------------------------------------------------------------------+
int BacktestProfOutsideBetweenOntimersSplitSection(const int enteringScopeKind)
{
   if(enteringScopeKind == BACKTEST_PROF_SCOPE_ONDEINIT)
      return BacktestProfOutsideGapSectionForEntry(enteringScopeKind);
   if(enteringScopeKind == BACKTEST_PROF_SCOPE_ONTIMER &&
      g_backtestProfLastScopeKind == BACKTEST_PROF_SCOPE_ONINIT)
      return BacktestProfOutsideGapSectionForEntry(enteringScopeKind);

   const int pendingBucket = BacktestProfGapPendingBucketIndex(BacktestProfPendingOrdersOnSymbol());
   const bool bdOpen = BacktestProfFamilyHasOpenOnSymbol(true);
   const bool timeOpen = !bdOpen && BacktestProfFamilyHasOpenOnSymbol(false);

   if(enteringScopeKind == BACKTEST_PROF_SCOPE_ONTRADE)
      return BacktestProfOutsideGapSectionForOpenState(bdOpen, timeOpen, false, pendingBucket);

   const datetime barNowM1 = iTime(_Symbol, PERIOD_M1, 0);
   const bool isM1CloseTick = (barNowM1 != g_lastBarTime);
   return BacktestProfOutsideGapSectionForOpenState(bdOpen, timeOpen, isM1CloseTick, pendingBucket);
}

//+------------------------------------------------------------------+
void BacktestProfRecordOutsideGapSinceLastScopeEnd(const int enteringScopeKind)
{
   if(!BacktestProfileEnabled() || g_backtestProfLastScopedEndUs == 0)
      return;
   const ulong now = GetMicrosecondCount();
   if(now <= g_backtestProfLastScopedEndUs)
      return;
   const ulong elapsed = now - g_backtestProfLastScopedEndUs;
   BacktestProfAccumulateGap(BacktestProfOutsideBetweenOntimersSplitSection(enteringScopeKind), elapsed);
}

//+------------------------------------------------------------------+
ulong BacktestProfSumOutsideOntimerUs(const BacktestProfBucket &buckets[])
{
   ulong sum = 0;
   for(int i = 0; i < ArraySize(BACKTEST_PROF_OUTSIDE_ONTIMER_SUB_SECTIONS); i++)
      sum += buckets[BACKTEST_PROF_OUTSIDE_ONTIMER_SUB_SECTIONS[i]].totalUs;
   return sum;
}

//+------------------------------------------------------------------+
void BacktestProfAddCounter(const int section, const int count = 1)
{
   if(section < 0 || section >= BACKTEST_PROF_SECTION_COUNT || count <= 0)
      return;
   if(!BacktestProfileEnabled() || !g_backtestProfArmed)
      return;
   g_backtestProfRunTotals[section].calls += count;
   g_backtestProfDayTotals[section].calls += count;
}

//+------------------------------------------------------------------+
ulong BacktestProfCheapGateT0()
{
   if(!g_breakdownProfileCheapGatesActive || !BacktestProfileEnabled() || !g_backtestProfArmed)
      return 0;
   return GetMicrosecondCount();
}

//+------------------------------------------------------------------+
void BacktestProfCheapGateAccumulate(const int section, const ulong t0)
{
   if(t0 > 0)
      BacktestProfAccumulate(section, t0);
}

//+------------------------------------------------------------------+
ulong BacktestProfBreakdownCheapGatesUs(const BacktestProfBucket &buckets[])
{
   return buckets[BACKTEST_PROF_BREAKDOWN_CHEAP_CLOSE_BAR].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_CHEAP_DAY_STOPS].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_CHEAP_MAX_OPEN_POS_SCAN].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_CHEAP_MAX_OPEN_ORD_SCAN].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_CHEAP_MAX_PENDING_ORD_SCAN].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_CHEAP_FAMILY_OCCUPIED].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_CHEAP_FAMILY_HAD_CLOSE].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_CHEAP_RECENCY].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_CHEAP_MAX_VOLUME].totalUs;
}

//+------------------------------------------------------------------+
ulong BacktestProfBreakdownPlacementRollupUs(const BacktestProfBucket &buckets[])
{
   return buckets[BACKTEST_PROF_BREAKDOWN_PLACEMENT_15M_SNAP].totalUs
      + BacktestProfBreakdownCheapGatesUs(buckets)
      + buckets[BACKTEST_PROF_BREAKDOWN_PLACEMENT_CANDIDATES_SNAP].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_PLACEMENT_SETUP].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_PLACEMENT_MIDPOINT_RULES].totalUs
      + buckets[BACKTEST_PROF_BREAKDOWN_PLACEMENT_ORDERS].totalUs;
}

//+------------------------------------------------------------------+
ulong BacktestProfLevelPlacementRollupUs(const BacktestProfBucket &buckets[])
{
   return buckets[BACKTEST_PROF_LEVEL_ALGO_PLACEMENT_SETUP].totalUs
      + buckets[BACKTEST_PROF_LEVEL_ALGO_PLACEMENT_BAR_LEVELS].totalUs
      + buckets[BACKTEST_PROF_LEVEL_ALGO_PLACEMENT_CHEAP].totalUs
      + buckets[BACKTEST_PROF_LEVEL_ALGO_PLACEMENT_NEAR_LEVEL].totalUs
      + buckets[BACKTEST_PROF_LEVEL_ALGO_PLACEMENT_ORDERS].totalUs;
}

//+------------------------------------------------------------------+
void BacktestProfWriteBreakdownPlacementRollupRow(const int fh, const string datePrefix,
   const BacktestProfBucket &buckets[], const ulong runtimeTotalUs)
{
   for(int i = 0; i < ArraySize(BACKTEST_PROF_BD_PLACEMENT_SUB_SECTIONS); i++)
   {
      const int section = BACKTEST_PROF_BD_PLACEMENT_SUB_SECTIONS[i];
      if(buckets[section].calls <= 0 && buckets[section].totalUs == 0)
         continue;
      const double subS = (double)buckets[section].totalUs / 1000000.0;
      const double subMin = subS / 60.0;
      const double subPctRuntime = (runtimeTotalUs == 0) ? 0.0 :
         100.0 * (double)buckets[section].totalUs / (double)runtimeTotalUs;
      const double subTotalMs = (double)buckets[section].totalUs / 1000.0;
      const double subAvgMs = (buckets[section].calls > 0) ? subTotalMs / (double)buckets[section].calls : 0.0;
      const double subMaxMs = (double)buckets[section].maxUs / 1000.0;
      const string label = BacktestProfSectionLabel(section);
      if(StringLen(datePrefix) > 0)
         FileWrite(fh, datePrefix, label,
            DoubleToString(subS, 2), DoubleToString(subMin, 2), IntegerToString(buckets[section].calls),
            DoubleToString(subAvgMs, 3), DoubleToString(subMaxMs, 3),
            DoubleToString(subPctRuntime, 1));
      else
         FileWrite(fh, label,
            DoubleToString(subS, 2), DoubleToString(subMin, 2), IntegerToString(buckets[section].calls),
            DoubleToString(subAvgMs, 3), DoubleToString(subMaxMs, 3),
            DoubleToString(subPctRuntime, 1));
   }
}

//+------------------------------------------------------------------+
void BacktestProfWriteLevelPlacementRollupRow(const int fh, const string datePrefix,
   const BacktestProfBucket &buckets[], const ulong runtimeTotalUs)
{
   for(int i = 0; i < ArraySize(BACKTEST_PROF_LEVEL_PLACEMENT_SUB_SECTIONS); i++)
   {
      const int section = BACKTEST_PROF_LEVEL_PLACEMENT_SUB_SECTIONS[i];
      if(buckets[section].calls <= 0 && buckets[section].totalUs == 0)
         continue;
      const double subS = (double)buckets[section].totalUs / 1000000.0;
      const double subMin = subS / 60.0;
      const double subPctRuntime = (runtimeTotalUs == 0) ? 0.0 :
         100.0 * (double)buckets[section].totalUs / (double)runtimeTotalUs;
      const double subTotalMs = (double)buckets[section].totalUs / 1000.0;
      const double subAvgMs = (buckets[section].calls > 0) ? subTotalMs / (double)buckets[section].calls : 0.0;
      const double subMaxMs = (double)buckets[section].maxUs / 1000.0;
      const string label = BacktestProfSectionLabel(section);
      if(StringLen(datePrefix) > 0)
         FileWrite(fh, datePrefix, label,
            DoubleToString(subS, 2), DoubleToString(subMin, 2), IntegerToString(buckets[section].calls),
            DoubleToString(subAvgMs, 3), DoubleToString(subMaxMs, 3),
            DoubleToString(subPctRuntime, 1));
      else
         FileWrite(fh, label,
            DoubleToString(subS, 2), DoubleToString(subMin, 2), IntegerToString(buckets[section].calls),
            DoubleToString(subAvgMs, 3), DoubleToString(subMaxMs, 3),
            DoubleToString(subPctRuntime, 1));
   }
}

//+------------------------------------------------------------------+
void BacktestProfWriteBreakdownMetaRows(const int fh, const string datePrefix)
{
   if(StringLen(datePrefix) > 0)
   {
      FileWrite(fh, datePrefix, "meta_bd_algo_count", "", "", IntegerToString(g_breakdownAlgoCount), "", "", "");
      FileWrite(fh, datePrefix, "meta_bd_snap_group_count", "", "", IntegerToString(g_breakdown15mSnapGroupCount), "", "", "");
   }
   else
   {
      FileWrite(fh, "meta_bd_algo_count", "", "", IntegerToString(g_breakdownAlgoCount), "", "", "");
      FileWrite(fh, "meta_bd_snap_group_count", "", "", IntegerToString(g_breakdown15mSnapGroupCount), "", "", "");
   }
}

//+------------------------------------------------------------------+
bool BacktestProfSectionIsBreakdownPlacementSubBucket(const int section)
{
   if(section == BACKTEST_PROF_BREAKDOWN_PLACEMENT_SETUP)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_PLACEMENT_15M_SNAP)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_CHEAP_CLOSE_BAR)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_CHEAP_DAY_STOPS)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_CHEAP_MAX_OPEN_POS_SCAN)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_CHEAP_MAX_OPEN_ORD_SCAN)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_CHEAP_MAX_PENDING_ORD_SCAN)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_CHEAP_FAMILY_OCCUPIED)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_CHEAP_FAMILY_HAD_CLOSE)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_CHEAP_RECENCY)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_CHEAP_MAX_VOLUME)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_PLACEMENT_CANDIDATES_SNAP)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_PLACEMENT_MIDPOINT_RULES)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_PLACEMENT_ORDERS)
      return true;
   return false;
}

//+------------------------------------------------------------------+
bool BacktestProfSectionIsLevelPlacementSubBucket(const int section)
{
   for(int i = 0; i < ArraySize(BACKTEST_PROF_LEVEL_PLACEMENT_SUB_SECTIONS); i++)
   {
      if(section == BACKTEST_PROF_LEVEL_PLACEMENT_SUB_SECTIONS[i])
         return true;
   }
   return false;
}

//+------------------------------------------------------------------+
bool BacktestProfSectionExcludedFromOntimerInteriorSum(const int section)
{
   if(section == BACKTEST_PROF_ONTIMER_TOTAL)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_PLACEMENT)
      return true;
   if(BacktestProfSectionIsBreakdownPlacementSubBucket(section))
      return true;
   if(BacktestProfSectionIsLevelPlacementSubBucket(section))
      return true;
   if(section >= BACKTEST_PROF_BD_STAT_CHEAP_SURVIVORS && section <= BACKTEST_PROF_BD_STAT_SNAP_GROUPS_COMPUTED)
      return true;
   if(section == BACKTEST_PROF_ONINIT)
      return true;
   if(section == BACKTEST_PROF_OUTSIDE_AFTER_ONINIT)
      return true;
   if(section == BACKTEST_PROF_OUTSIDE_BETWEEN_ONTIMERS)
      return true;
   if(BacktestProfSectionIsOutsideGapPendingBucket(section))
      return true;
   if(section == BACKTEST_PROF_OUTSIDE_BEFORE_ONDEINIT)
      return true;
   if(section == BACKTEST_PROF_OUTSIDE_ONTRADE)
      return true;
   if(section == BACKTEST_PROF_ONDEINIT)
      return true;
   return false;
}

//+------------------------------------------------------------------+
bool BacktestProfSectionExcludedFromCsvWrite(const int section)
{
   if(section == BACKTEST_PROF_ONTIMER_TOTAL)
      return true;
   if(section == BACKTEST_PROF_BREAKDOWN_PLACEMENT)
      return true;
   if(BacktestProfSectionIsBreakdownPlacementSubBucket(section))
      return true;
   if(BacktestProfSectionIsLevelPlacementSubBucket(section))
      return true;
   return false;
}

//+------------------------------------------------------------------+
ulong BacktestProfSumOntimerInteriorUs(const BacktestProfBucket &buckets[])
{
   ulong sum = 0;
   for(int i = 0; i < BACKTEST_PROF_SECTION_COUNT; i++)
   {
      if(BacktestProfSectionExcludedFromOntimerInteriorSum(i))
         continue;
      sum += buckets[i].totalUs;
   }
   sum += BacktestProfBreakdownPlacementRollupUs(buckets);
   sum += BacktestProfLevelPlacementRollupUs(buckets);
   return sum;
}

//+------------------------------------------------------------------+
ulong BacktestProfSumWallPartitionUs(const BacktestProfBucket &buckets[])
{
   return buckets[BACKTEST_PROF_ONINIT].totalUs
      + BacktestProfSumOutsideOntimerUs(buckets)
      + buckets[BACKTEST_PROF_ONTIMER_TOTAL].totalUs
      + buckets[BACKTEST_PROF_ONDEINIT].totalUs;
}

//+------------------------------------------------------------------+
ulong BacktestProfSumCsvAccountableUs(const BacktestProfBucket &buckets[])
{
   const ulong ontimerUs = buckets[BACKTEST_PROF_ONTIMER_TOTAL].totalUs;
   const ulong interiorUs = BacktestProfSumOntimerInteriorUs(buckets);
   const ulong unprofiledUs = (ontimerUs > interiorUs) ? (ontimerUs - interiorUs) : 0;
   return buckets[BACKTEST_PROF_ONINIT].totalUs
      + BacktestProfSumOutsideOntimerUs(buckets)
      + interiorUs
      + unprofiledUs
      + buckets[BACKTEST_PROF_ONDEINIT].totalUs;
}

//+------------------------------------------------------------------+
bool BacktestProfSectionExcludedFromOntimerLeafSum(const int section)
{
   return BacktestProfSectionExcludedFromOntimerInteriorSum(section);
}

//+------------------------------------------------------------------+
ulong BacktestProfSumLeafProfiledUsExceptOnTimer(const BacktestProfBucket &buckets[])
{
   return BacktestProfSumOntimerInteriorUs(buckets);
}

//+------------------------------------------------------------------+
ulong BacktestProfSumProfiledUsExceptOnTimer(const BacktestProfBucket &buckets[])
{
   return BacktestProfSumLeafProfiledUsExceptOnTimer(buckets);
}

//+------------------------------------------------------------------+
void BacktestProfWriteRuntimeAccountingRows(const int fh, const string datePrefix,
   const BacktestProfBucket &buckets[], const ulong wallTotalUs)
{
   if(wallTotalUs == 0 && BacktestProfSumWallPartitionUs(buckets) == 0)
      return;

   const double wallS = (double)wallTotalUs / 1000000.0;
   if(StringLen(datePrefix) > 0)
      FileWrite(fh, datePrefix, "runtime_total",
         DoubleToString(wallS, 2), DoubleToString(wallS / 60.0, 2), "0",
         "0.000", "0.000", "100.0");
   else
      FileWrite(fh, "runtime_total",
         DoubleToString(wallS, 2), DoubleToString(wallS / 60.0, 2), "0",
         "0.000", "0.000", "100.0");
}

//+------------------------------------------------------------------+
void BacktestProfWriteRuntimeChecksumRows(const int fh, const string datePrefix,
   const BacktestProfBucket &buckets[], const ulong wallTotalUs)
{
   const ulong pctDenomUs = (wallTotalUs > 0) ? wallTotalUs : BacktestProfSumWallPartitionUs(buckets);
   const ulong ontimerUs = buckets[BACKTEST_PROF_ONTIMER_TOTAL].totalUs;
   const ulong interiorUs = BacktestProfSumOntimerInteriorUs(buckets);
   const ulong unprofiledUs = (ontimerUs > interiorUs) ? (ontimerUs - interiorUs) : 0;
   const ulong accountedUs = BacktestProfSumCsvAccountableUs(buckets);
   const ulong residualUs = (wallTotalUs > accountedUs) ? (wallTotalUs - accountedUs) : 0;

   const double unprofiledS = (double)unprofiledUs / 1000000.0;
   const double residualS = (double)residualUs / 1000000.0;
   const double unprofiledPct = (pctDenomUs > 0) ? 100.0 * (double)unprofiledUs / (double)pctDenomUs : 0.0;
   const double residualPct = (pctDenomUs > 0) ? 100.0 * (double)residualUs / (double)pctDenomUs : 0.0;

   if(unprofiledUs > 0 || interiorUs > 0)
   {
      if(StringLen(datePrefix) > 0)
         FileWrite(fh, datePrefix, "runtime_unprofiled",
            DoubleToString(unprofiledS, 2), DoubleToString(unprofiledS / 60.0, 2), "0",
            "0.000", "0.000", DoubleToString(unprofiledPct, 1));
      else
         FileWrite(fh, "runtime_unprofiled",
            DoubleToString(unprofiledS, 2), DoubleToString(unprofiledS / 60.0, 2), "0",
            "0.000", "0.000", DoubleToString(unprofiledPct, 1));
   }
   if(residualUs > 0)
   {
      if(StringLen(datePrefix) > 0)
         FileWrite(fh, datePrefix, "runtime_residual",
            DoubleToString(residualS, 2), DoubleToString(residualS / 60.0, 2), "0",
            "0.000", "0.000", DoubleToString(residualPct, 1));
      else
         FileWrite(fh, "runtime_residual",
            DoubleToString(residualS, 2), DoubleToString(residualS / 60.0, 2), "0",
            "0.000", "0.000", DoubleToString(residualPct, 1));
   }
}

//+------------------------------------------------------------------+
ulong BacktestProfUnaccountedOnTimerUs(const BacktestProfBucket &buckets[])
{
   const ulong runtimeUs = buckets[BACKTEST_PROF_ONTIMER_TOTAL].totalUs;
   const ulong profiledUs = BacktestProfSumLeafProfiledUsExceptOnTimer(buckets);
   return (runtimeUs > profiledUs) ? (runtimeUs - profiledUs) : 0;
}

//+------------------------------------------------------------------+
void BacktestProfWriteOneBucketRow(const int fh, const string datePrefix, const int section,
   const BacktestProfBucket &buckets[], const ulong runtimeTotalUs)
{
   if(buckets[section].calls <= 0 && buckets[section].totalUs == 0)
      return;
   const double totalMs = (double)buckets[section].totalUs / 1000.0;
   const double totalS = (double)buckets[section].totalUs / 1000000.0;
   const double totalMin = totalS / 60.0;
   const double avgMs = (buckets[section].calls > 0) ? totalMs / (double)buckets[section].calls : 0.0;
   const double maxMs = (double)buckets[section].maxUs / 1000.0;
   const double pct = (runtimeTotalUs == 0) ? 0.0 :
      100.0 * (double)buckets[section].totalUs / (double)runtimeTotalUs;
   if(StringLen(datePrefix) > 0)
   {
      FileWrite(fh, datePrefix, BacktestProfSectionLabel(section),
         DoubleToString(totalS, 2), DoubleToString(totalMin, 2), IntegerToString(buckets[section].calls),
         DoubleToString(avgMs, 3), DoubleToString(maxMs, 3), DoubleToString(pct, 1));
   }
   else
   {
      FileWrite(fh, BacktestProfSectionLabel(section),
         DoubleToString(totalS, 2), DoubleToString(totalMin, 2), IntegerToString(buckets[section].calls),
         DoubleToString(avgMs, 3), DoubleToString(maxMs, 3), DoubleToString(pct, 1));
   }
}

//+------------------------------------------------------------------+
void BacktestProfWriteBucketRows(const int fh, const string datePrefix, const BacktestProfBucket &buckets[],
   const ulong wallTotalUs)
{
   const ulong pctDenomUs = (wallTotalUs > 0) ? wallTotalUs : BacktestProfSumWallPartitionUs(buckets);
   BacktestProfWriteRuntimeAccountingRows(fh, datePrefix, buckets, wallTotalUs);
   for(int i = 0; i < BACKTEST_PROF_SECTION_COUNT; i++)
   {
      if(BacktestProfSectionExcludedFromCsvWrite(i))
         continue;
      BacktestProfWriteOneBucketRow(fh, datePrefix, i, buckets, pctDenomUs);
   }
   BacktestProfWriteBreakdownPlacementRollupRow(fh, datePrefix, buckets, pctDenomUs);
   BacktestProfWriteLevelPlacementRollupRow(fh, datePrefix, buckets, pctDenomUs);
   BacktestProfWriteBreakdownMetaRows(fh, datePrefix);
   BacktestProfWriteRuntimeChecksumRows(fh, datePrefix, buckets, wallTotalUs);
}

//+------------------------------------------------------------------+
void BacktestProfWriteDayRows(const datetime dayStart, const BacktestProfBucket &buckets[],
   const ulong wallTotalUs)
{
   const string dateStr = TimeToString(dayStart, TIME_DATE);
   const string fileName = "backtest_profile_by_day.csv";
   int fh = FileOpen(fileName, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ | FILE_SHARE_WRITE);
   if(fh == INVALID_HANDLE)
      return;
   const bool writeHeader = (FileSize(fh) == 0);
   FileSeek(fh, 0, SEEK_END);
   if(writeHeader)
      FileWrite(fh, "date", "section", "total_s", "total_minutes", "calls", "avg_ms", "max_ms", "pct_of_runtime_total");
   BacktestProfWriteBucketRows(fh, dateStr, buckets, wallTotalUs);
   FileClose(fh);
}

//+------------------------------------------------------------------+
void BacktestProfFlushCurrentDayIfNeeded()
{
   if(!BacktestProfileEnabled() || g_backtestProfTrackingDayStart == 0)
      return;
   const ulong dayWallUs = BacktestProfWallElapsedUs(g_backtestProfDayWallStartUs);
   BacktestProfWriteDayRows(g_backtestProfTrackingDayStart, g_backtestProfDayTotals, dayWallUs);
}

//+------------------------------------------------------------------+
void BacktestProfOnTimerDayRollover(const datetime dayStart)
{
   if(!BacktestProfileEnabled())
      return;
   if(g_backtestProfTrackingDayStart == 0)
   {
      g_backtestProfTrackingDayStart = dayStart;
      return;
   }
   if(dayStart == g_backtestProfTrackingDayStart)
      return;
   const ulong dayWallUs = BacktestProfWallElapsedUs(g_backtestProfDayWallStartUs);
   BacktestProfWriteDayRows(g_backtestProfTrackingDayStart, g_backtestProfDayTotals, dayWallUs);
   BacktestProfZeroBuckets(g_backtestProfDayTotals);
   g_backtestProfTrackingDayStart = dayStart;
   g_backtestProfDayWallStartUs = GetMicrosecondCount();
}

//+------------------------------------------------------------------+
void BacktestProfWriteRunSummary()
{
   if(!BacktestProfileEnabled())
      return;
   BacktestProfFlushCurrentDayIfNeeded();
   const string fileName = "backtest_profile_run_summary.csv";
   int fh = FileOpen(fileName, FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ | FILE_SHARE_WRITE);
   if(fh == INVALID_HANDLE)
      return;
   FileWrite(fh, "section", "total_s", "total_minutes", "calls", "avg_ms", "max_ms", "pct_of_runtime_total");
   const ulong runWallUs = BacktestProfWallElapsedUs(g_backtestProfRunWallStartUs);
   BacktestProfWriteBucketRows(fh, "", g_backtestProfRunTotals, runWallUs);
   FileClose(fh);
}

//--- Live price (updated every OnTimer ~1s); use for proximity/display without reading terminal each time
double g_liveBid = 0.0;
double g_liveAsk = 0.0;

//--- For OnTimer: last bar time we processed (current bar start time)
datetime g_lastBarTime = 0;

//--- Algorithm start date - only show trade history from this date in log allTradesHistoryForAllLevels_andAllAccountData
datetime dateWhenAlgoTradeStarted = StringToTime("2026.01.23 00:00");

//--- Calendar (loaded from CSV in OnInit)
struct CalendarRow
{
   string dateStr;    // "YYYY.MM.DD" (MT5 default, matches TimeToString(..., TIME_DATE))
   int    dayofmonth;
   string dayofweek;
   bool   opex;
   bool   qopex;
};
CalendarRow g_calendar[MAX_CALENDAR_ROWS];
int g_calendarCount = 0;

//--- Levels (loaded from levelsinfo_zeFinal CSV; OnInit + daily reload at 01:45)
struct LevelInfoRow
{
   string startStr;   // "YYYY.MM.DD"
   string endStr;     // "YYYY.MM.DD"
   double levelPrice;
   string categories; // e.g. "daily_monday_pivot_stacked"
   string tag;       // e.g. "dailyPivot", "weeklyUp1" (loaded but not used yet)
};
LevelInfoRow g_levels[MAX_LEVEL_ROWS];
int g_levelsTotalCount = 0;  // levels for active levels-file day only (reloaded at 01:45)
string g_levelsLoadedForDate = "";  // YYYY.MM.DD loaded from CSV (FalgoLevelsActiveDateStrForTime)
string g_falgoTradingDayHandledFor = "";  // active trading day (rolls at 01:45, not calendar midnight)
#define LEVELS_FILE_RELOAD_HOUR   1
#define LEVELS_FILE_RELOAD_MINUTE 45
// Limbo window: calendar midnight until LEVELS_FILE_RELOAD (01:45). Babysit frozen; M1 pipeline frozen on Sat/Sun too.
#define FALGO_LIMBO_WINDOW_END_HOUR   LEVELS_FILE_RELOAD_HOUR
#define FALGO_LIMBO_WINDOW_END_MINUTE LEVELS_FILE_RELOAD_MINUTE
bool FalgoIsLimboWindowAtTime(const datetime t);
bool FalgoIsLimboWindowNow();
bool FalgoIsM1PipelineFrozenAtTime(const datetime t);

//--- Levels expanded (built in testing loop: each level of the day vs whole price chart; newway_Diff_CloseToLevel per bar)
struct LevelExpandedRow
{
   double levelPrice;
   string tag;
   string categories;  // from CSV; used to exclude tertiary from break-check summary
   string categoriesLower;  // lowercase copy; hot paths avoid repeated StringToLower
   int    count;      // number of bars
   double diffs[];    // newway_Diff_CloseToLevel = close - levelPrice per bar
   datetime times[];  // bar time per bar
};
LevelExpandedRow g_levelsExpanded[MAX_LEVELS_EXPANDED];
int g_levelsTodayCount = 0;  // levels valid for current day (from g_levels); per-bar data in g_levelsExpanded[e]
// Per (level e, bar k): candle breaks level down/up (from g_m1Rates OHLC); filled in UpdateDayM1AndLevelsExpanded; logged in testinglevelsplus
bool g_breaksLevelDown[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];    // true if open > level AND close < level
bool g_breaksLevelUpward[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];  // true if open < level AND close > level
// Per (level e, bar k): number of consecutive bars (from k-1 backward) with all OHLC above/below level
int  g_cleanStreakAbove[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
int  g_cleanStreakBelow[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
// Per (level e, bar k): count and % of bars 0..k (so far today) with all OHLC above/below level
int    g_aboveCnt[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
double g_abovePerc[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
int    g_belowCnt[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
double g_belowPerc[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
// Per (level e, bar k): overlap = level between H and L; streak = consecutive overlapping bars backward; overlapC/overlapPc = count and % so far today
int    g_overlapStreak[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
int    g_overlapC[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
double g_overlapPc[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
// Per (level e, bar k): trade history for this level as of bar k close (trades with endTime < bar k close); minute-by-minute tracking
int    g_ONtradeCount_L[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
int    g_ONwins_L[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
double g_ONpointsSum_L[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
double g_ONprofitSum_L[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
int    g_RTHtradeCount_L[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
int    g_RTHwins_L[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
double g_RTHpointsSum_L[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];
double g_RTHprofitSum_L[MAX_LEVELS_EXPANDED][MAX_BARS_IN_DAY];

//--- Day M1 price data (updated every new bar; used by trade logic and by testing log)
MqlRates g_m1Rates[MAX_BARS_IN_DAY];  // day's bars only, index k = k-th bar of day
int g_barsInDay = 0;
datetime g_m1DayStart = 0;  // which day g_m1Rates is for (0 = not set)
datetime g_buyHoldFirstDayStart = 0;
double   g_buyHoldCompletedTradingMinutes = 0.0;
int      g_buyHoldSnapshotM1BarCount = 0;
double   g_buyHoldFirstOOD = 0.0;
double   g_buyHoldFirstHOD = 0.0;
double   g_buyHoldFirstLOD = 0.0;
double   g_buyHoldFirstCOD = 0.0;
bool     g_buyHoldFirstDayFrozen = false;
double   g_buyHoldRunMaxHigh = 0.0;
double   g_buyHoldRunMinLow = 0.0;
bool     g_buyHoldRunExtremesInit = false;
datetime g_buyHoldSnapshotDayStart = 0;
double   g_buyHoldSnapshotOOD = 0.0;
double   g_buyHoldSnapshotHOD = 0.0;
double   g_buyHoldSnapshotLOD = 0.0;
double   g_buyHoldSnapshotCOD = 0.0;
bool     g_buyHoldSnapshotValid = false;
datetime g_buyHoldDayOhlcDayStart = 0;
